---
permalink: /css/tokens.css
eleventyExcludeFromCollections: true
---
{%- set c = theme.colors -%}
{%- set f = theme.fonts -%}
{%- set s = theme.scale -%}
{%- set lh = theme.lineHeight -%}
{%- set sp = theme.spacing -%}
{%- set l = theme.layout -%}
{%- set g = theme.grade -%}
{%- set m = theme.motion -%}
/* =====================================================================
   Dr. Stephen de Wit — Design System Tokens
   Neutral plum, cream and ivory, with one lavender-mauve accent
   ===================================================================== */

:root {
  /* --- Accent: one desaturated lavender-mauve, for hairlines, small
     labels and link underlines only. --accent on light grounds,
     --accent-2 (the lighter tint) on dark grounds. ------------------- */
  --accent:        {{ c.accent }};
  --accent-2:      {{ c["accent-2"] }};

  /* The violet names are kept for the homepage's own rules; they map onto
     the same neutral plum family and the one accent. */
  --violet:        {{ c.violet }};
  --violet-600:    {{ c["violet-600"] }};
  --violet-500:    {{ c["violet-500"] }};
  --violet-300:    {{ c["violet-300"] }};
  --violet-200:    {{ c["violet-200"] }};
  --violet-100:    {{ c["violet-100"] }};

  /* --- Neutrals ---------------------------------------------------- */
  --ivory:         {{ c.ivory }};
  --cream:         {{ c.cream }};
  --mist:          {{ c.mist }};
  --paper:         {{ c.paper }};
  --paper-2:       {{ c["paper-2"] }};
  --paper-3:       {{ c["paper-3"] }};

  --plum:          {{ c.plum }};
  --plum-2:        {{ c["plum-2"] }};
  --ink:           {{ c.ink }};
  --ink-2:         {{ c["ink-2"] }};
  --stage-black:   {{ c["stage-black"] }};
  --indigo:        {{ c.indigo }};
  --indigo-2:      {{ c["indigo-2"] }};
  --aub:           {{ c.aub }};
  --aub-2:         {{ c["aub-2"] }};
  --violet-deep:   {{ c["violet-deep"] }};

  /* Dark section grounds: calm, deep and desaturated. Each inner page
     takes one of the mid-tones for its accent band. */
  --ground-plum:      {{ c["ground-plum"] }};
  --ground-aubergine: {{ c["ground-aubergine"] }};
  --ground-violet:    {{ c["ground-violet"] }};
  --ground-indigo:    {{ c["ground-indigo"] }};
  --ground-damson:    {{ c["ground-damson"] }};
  --ground-deep:      {{ c["ground-deep"] }};
  --ground-stage:     {{ c["stage-black"] }};

  /* --- Text -------------------------------------------------------- */
  --tx:            {{ c.tx }};
  --tx-soft:       {{ c["tx-soft"] }};
  --tx-faint:      {{ c["tx-faint"] }};
  --tx-inv:        {{ c["tx-inv"] }};
  --tx-inv-soft:   {{ c["tx-inv-soft"] }};
  --tx-inv-faint:  {{ c["tx-inv-faint"] }};

  /* --- Lines ------------------------------------------------------- */
  --line:          {{ c.line }};
  --line-strong:   {{ c["line-strong"] }};
  --line-inv:      {{ c["line-inv"] }};
  --line-inv-strong: {{ c["line-inv-strong"] }};

  /* --- Type -------------------------------------------------------- */
  --f-display: {{ f.display | safe }};
  --f-text:    {{ f.text | safe }};

  /* Fluid scale — pushed to editorial/cinematic scale */
  --step--1: {{ s["step--1"] }};
  --step-0:  {{ s["step-0"] }};
  --step-1:  {{ s["step-1"] }};
  --step-2:  {{ s["step-2"] }};
  --step-3:  {{ s["step-3"] }};
  --step-4:  {{ s["step-4"] }};
  --step-5:  {{ s["step-5"] }};   /* big statements */
  --step-6:  {{ s["step-6"] }};     /* name-as-graphic / hero */

  --lh-tight: {{ lh.tight }};
  --lh-snug:  {{ lh.snug }};
  --lh-text:  {{ lh.text }};

  /* --- Space (8px base, fluid section rhythm) --------------------- */
  --sp-1: {{ sp["sp-1"] }};  --sp-2: {{ sp["sp-2"] }};   --sp-3: {{ sp["sp-3"] }};  --sp-4: {{ sp["sp-4"] }};
  --sp-5: {{ sp["sp-5"] }};    --sp-6: {{ sp["sp-6"] }}; --sp-7: {{ sp["sp-7"] }};  --sp-8: {{ sp["sp-8"] }};
  --section-y: {{ sp["section-y"] }};

  /* --- Layout ------------------------------------------------------ */
  --wrap:      {{ l.wrap }};
  --wrap-text: {{ l["wrap-text"] }};
  --gutter:    {{ l.gutter }};
  --radius:    {{ l.radius }};      /* restrained — brand avoids rounded-rect look */

  /* --- Filmic image grade (cohesion across mixed photography) ------ */
  --img-filter: {{ g.filter }};
  --grade-plum: {{ g.plum }};
  --grade-warm: {{ g.warm }};

  /* --- Motion ------------------------------------------------------ */
  --ease-out:   {{ m.easeOut }};     /* entrances */
  --ease-amb:   {{ m.easeAmb }};     /* ambient */
  --dur-fast:   {{ m.durFast }};
  --dur:        {{ m.dur }};
  --dur-slow:   {{ m.durSlow }};

  --shadow-soft: {{ theme.shadow.soft }};
}

/* =====================================================================
   Page gradient: each page is one ground colour (--g3) running down from
   a pale tint of itself. The light half darkens from --g0 to --g1, a short
   dusk turns --g1 into --g2 in the gap between two sections, and the dark
   half darkens from --g2 to --g3. html carries data-page, so the footer
   and the canvas use the bottom stop too.
   ===================================================================== */
{%- set pg0 = theme.pageGradients.home %}
:root { --g0: {{ pg0[0] }}; --g1: {{ pg0[1] }}; --g2: {{ pg0[2] }}; --g3: {{ pg0[3] }}; }
{%- for slug, stops in theme.pageGradients %}
[data-page="{{ slug }}"] { --g0: {{ stops[0] }}; --g1: {{ stops[1] }}; --g2: {{ stops[2] }}; --g3: {{ stops[3] }}; }
{%- endfor %}

/* =====================================================================
   Text schemes. Every colour that sits on the gradient comes from these
   variables, so one attribute (data-scheme="light" | "dark") sets a
   section's text, hairlines, buttons, links, focus ring and logos.
   Sections above the page's split section take the light scheme and the
   split section and everything after it take the dark one, so no section
   straddles the dusk. The rule below sets this without script too.
   The older names (--tx-inv, --line-inv, --violet-300 ...) follow too.
   ===================================================================== */
{%- macro scheme(s) %}
  --tx: {{ s.tx }}; --tx-soft: {{ s["tx-soft"] }}; --tx-faint: {{ s["tx-faint"] }}; --tx-dim: {{ s["tx-dim"] }};
  --line: {{ s.line }}; --line-strong: {{ s["line-strong"] }};
  --accent: {{ s.accent }}; --focus: {{ s.focus }}; --logo: {{ s.tx }};
  --btn-bg: {{ s["btn-bg"] }}; --btn-fg: {{ s["btn-fg"] }}; --btn-hover: {{ s["btn-hover"] }};
  --veil-bg: {{ s["veil-bg"] }}; --veil-line: {{ s["veil-line"] }};
  --tx-inv: {{ s.tx }}; --tx-inv-soft: {{ s["tx-soft"] }}; --tx-inv-faint: {{ s["tx-faint"] }};
  --line-inv: {{ s.line }}; --line-inv-strong: {{ s["line-strong"] }};
  --violet: {{ s.accent }}; --violet-300: {{ s.accent }}; --violet-400: {{ s.accent }}; --violet-500: {{ s.accent }};
  --accent-2: {{ s.accent }}; --dd-page-acc: {{ s.accent }};
  --ground: transparent;
  color: var(--tx);
{%- endmacro %}
[data-scheme="light"], #main > :not([data-scheme]) {
{{- scheme(theme.schemes.light) }}
  --nav-ground: color-mix(in srgb, var(--g0) 94%, transparent);
  --logo-filter: brightness(0) invert(.11);
}
[data-scheme="dark"]
{%- for slug, sel in theme.gradientSplit %},
html[data-page="{{ slug }}"] #main > {{ sel }}:not([data-scheme]),
html[data-page="{{ slug }}"] #main > {{ sel }} ~ :not([data-scheme])
{%- endfor %} {
{{- scheme(theme.schemes.dark) }}
  --nav-ground: color-mix(in srgb, var(--g3) 94%, transparent);
  --logo-filter: brightness(0) invert(1);
}
