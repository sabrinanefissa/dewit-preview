{%- from "dd.njk" import dd %}
  {%- if block.editorNote %}
  {# Editor note: {{ block.editorNote | plain }} #}
  {%- endif %}
  {# ==============================================================
       One keynote. The jump row to every talk on the page (a plain row,
       never sticky; hidden on phones, where the index already lists every
       talk). Then the talk's photo, large, with its number, title and
       premise: on the photo's own black side when image.textSide names
       one ("right" or "left"), otherwise beside the photo on the talk's
       ground (image.side puts the photo "left" or "right"). Under it, in
       view: what the room leaves with, the formats and "Book this talk".
       In one drop-down: the full description and who it is for.
       ============================================================== #}
  {%- set no = page.blocks | talkNo(block.id) %}
  {%- set img = block.image %}
  {%- set hasImg = img and img.src %}
  {%- set lay = ('over-' ~ img.textSide) if (hasImg and img.textSide) else (('photo-' ~ (img.side or 'left')) if hasImg else 'type') %}
  <section class="kn-talk kn-talk--{{ lay }}{% if block.signature %} kn-talk--sig{% endif %}"{% if block.id %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('plum') }}" style="--acc: var(--{{ block.accent | accentVar }})">
    <nav class="kn-jump" aria-label="{{ block.jumpLabel or 'Jump to a keynote' }}, from {{ block.title | plain }}{% if block.trademark %}™{% endif %}">
      <ul>
      {%- for t in page.blocks | talks %}
        <li><a href="#{{ t.id }}"{% if t.id == block.id %} aria-current="true"{% endif %}>{{ t.title | inline() }}{% if t.trademark %}<span class="tm">™</span>{% endif %}</a></li>
      {%- endfor %}
      </ul>
    </nav>
    <div class="kn-talk__grid">
      <div class="kn-talk__stage">
        {%- if hasImg %}
        <figure class="kn-talk__fig">
          <div class="media kn-talk__media">
            <img src="{{ img.src | root(r) }}" {%- set ss1 = img.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %} sizes="{{ img.sizes or '94vw' }}" alt="{{ img.alt | inline() }}"{% if img.position %} style="object-position: {{ img.position | plain }}"{% endif %} loading="lazy" decoding="async">
          </div>
        </figure>
        {%- endif %}
        <header class="kn-talk__head">
          {%- if no %}
          <span class="kn-talk__n" aria-hidden="true">{{ no | pad2 }}</span>
          {%- endif %}
          <h2 class="kn-talk__h" id="{{ block.id }}-h">{{ block.title | inline() }}{% if block.trademark %}<span class="tm">™</span>{% endif %}</h2>
          {%- if block.subtitle %}
          <p class="kn-talk__sub">{{ block.subtitle | inline() }}</p>
          {%- endif %}
          <p class="kn-talk__premise">{{ block.premise | inline('kn-em') }}</p>
        </header>
      </div>

      <div class="kn-talk__cols">
        <div class="kn-talk__col kn-talk__col--out">
          <h3 class="kn-talk__h3">{{ block.outcomesHeading | inline() }}</h3>
          <ul class="kn-talk__out">
          {%- for o in block.outcomes %}
            <li>{{ o | inline() }}</li>
          {%- endfor %}
          </ul>
        </div>
        <div class="kn-talk__col kn-talk__col--book">
          <h3 class="kn-talk__h3">{{ block.formatsHeading | inline() }}</h3>
          <ul class="kn-talk__formats">
          {%- for f in block.formats %}
            <li>{{ f | inline() }}</li>
          {%- endfor %}
          </ul>
          {%- if block.bookLabel and block.id %}
          {# Book this talk: /book/?talk=<this talk's id> pre-selects it in
               the enquiry form (js/book.js reads ?talk=; an unknown id
               falls back to "Not sure yet"). #}
          <a class="btn kn-talk__book" href="{{ ('book/?talk=' ~ block.id) | root(r) }}">{{ block.bookLabel | inline() }}<span class="kn-vh">: {{ block.title | plain }}{% if block.trademark %}™{% endif %}</span></a>
          {%- endif %}
          {%- if block.link and block.link.href %}
          <a class="textlink kn-talk__link" href="{{ block.link.href | root(r) }}">{{ block.link.label | inline() }}
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          {%- endif %}
        </div>
        <div class="kn-talk__more">
          {%- call dd(block.detailsLabel or "The full description and who it’s for", block.id ~ '-more') %}
          <div class="kn-talk__desc">
          {%- for para in block.overview %}
            <p class="kn-talk__p">{{ para | inline() }}</p>
          {%- endfor %}
          {%- if block.outcomesNote %}
            <p class="kn-talk__p">{{ block.outcomesNote | inline() }}</p>
          {%- endif %}
          </div>
          <div class="kn-talk__fact">
            <h3 class="kn-talk__h3">{{ block.audienceHeading | inline() }}</h3>
            <p class="kn-talk__aud">{{ block.audience | inline() }}</p>
          </div>
          {%- endcall %}
        </div>
      </div>
    </div>
  </section>
