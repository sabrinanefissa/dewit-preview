{%- from "dd.njk" import dd %}
  {# Book: what happens next. The five steps as large numerals standing on
       one hairline, each title under its numeral: across on wide screens,
       down on phones. Each step lights as it comes into view
       (js/book.js). Under them, in a drop-down, the reply line and each
       step with its description. #}
  <section class="bk-steps"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('deep') }}">
    <div class="bk-steps__grid">
      {%- if block.heading %}
      <h2 class="bk-steps__h" id="{{ block.id }}-h">{{ block.heading | inline() }}</h2>
      {%- endif %}
      {%- if block.steps and block.steps.length %}
      <ol class="bk-stops" data-bk-stops>
      {%- for st in block.steps %}
        <li class="bk-stops__s"><span class="bk-stops__n" aria-hidden="true">{{ loop.index }}</span><span class="bk-stops__t">{{ st.title | inline() }}</span></li>
      {%- endfor %}
      </ol>
      {%- endif %}
      {%- call dd(block.detailsLabel or 'What happens next, in detail', block.id ~ '-detail', 'bk-steps__dd') %}
      {%- if block.intro %}
      <p class="bk-steps__intro">{{ block.intro | inline() }}</p>
      {%- endif %}
      <ol class="bk-steps__list">
      {%- for s in block.steps %}
        <li><span class="bk-steps__t">{{ s.title | inline() }}</span> <span class="bk-steps__d">{{ s.text | inline() }}</span></li>
      {%- endfor %}
      </ol>
      {%- endcall %}
    </div>
  </section>
