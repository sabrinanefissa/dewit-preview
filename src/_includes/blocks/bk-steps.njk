  {# Book: what happens next. The five booking steps as a plain numbered
       list (the sticky version belongs to Home). #}
  <section class="bk-steps"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('plum-2') }}">
    <div class="bk-steps__grid">
      <h2 class="bk-steps__h" id="{{ block.id }}-h">{{ block.heading | inline('bk-em') }}</h2>
      <ol class="bk-steps__list">
      {%- for s in block.steps %}
        <li><span class="bk-steps__t">{{ s.title | inline() }}</span> <span class="bk-steps__d">{{ s.text | inline() }}</span></li>
      {%- endfor %}
      </ol>
    </div>
  </section>
