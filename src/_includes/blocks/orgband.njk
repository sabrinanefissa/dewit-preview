  {# Credibility: one row per group, its label on the left and its marks
       on an even grid, each sized by its optical area (logo.scale). The
       marks are painted in the section's text colour. #}
  <section class="orgband"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-label="{{ block.ariaLabel | inline() }}" data-tone="{{ block | tone('plum') }}">
  {%- for lane in block.lanes %}
    <div class="orgband__row">
      <p class="orgband__label">{{ lane.label | inline() }}</p>
      {%- set nl = lane.logos.length %}
      <ul class="orgband__logos" style="--cols:{{ nl if nl <= 6 else ((nl + 1) / 2) | round(0, 'floor') }}">
      {%- for logo in lane.logos %}
        <li style="--i:{{ loop.index0 }}"><img src="{{ logo.src | root(r) }}" alt="{{ logo.alt | inline() }}"{% if logo.scale %} style="--s:{{ logo.scale | plain }}"{% endif %} loading="lazy" decoding="async"></li>
      {%- endfor %}
      </ul>
    </div>
  {%- endfor %}
    {%- if block.cta and block.cta.label %}
    <div class="orgband__cta reveal">
      {%- if block.cta.text %}
      <p>{{ block.cta.text | inline() }}</p>
      {%- endif %}
      <a class="btn" href="{{ block.cta.href | root(r) }}">{{ block.cta.label | inline() }}</a>
    </div>
    {%- endif %}
  </section>
