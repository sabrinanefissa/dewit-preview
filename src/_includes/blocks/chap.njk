{%- from "place.njk" import placeStyle %}
  <!-- What it's like in the room: the page's one pin, seven beats. The
       heading alone; then for each chapter its word, then its line. One
       thing on screen at a time, each arriving and leaving on the same
       time-based fade. Three stills, one per chapter, at full brightness
       (Think: a theatre from the first row; Feel: a couple on a sofa at
       night; Act: gold light paths across black marble), crossfading at
       each change of chapter and pushing in slowly across its two beats.
       Act's still is bright at the bottom, so its type sits high. The rail
       on the left carries the homepage dot between three stops. Phones and
       reduced motion: no pin, three stacked blocks. The chapter words are
       the accessible tablist. -->
  <!-- rises over the pinned talks stage: see .spk-chap margin-top -->
  {%- set beat = block | motion('beat', 70) %}
  <section class="spk-chap"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('plum-2') }}" data-beat="{{ beat }}" data-arrive="{{ block | motion('arrive', 440) }}" data-leave="{{ block | motion('leave', 320) }}" data-cross="{{ block | motion('cross', 900) }}" data-dolly="{{ block | motion('dolly', 1.06) }}" style="--chapters:{{ block.chapters.length }};--beat:{{ beat }}">
    <div class="spk-chap__track">
      <div class="spk-chap__stage">
        <div class="spk-chap__media" aria-hidden="true">
        {%- for c in block.chapters %}
          <img class="spk-chap__still{% if loop.first %} is-on{% endif %}" data-chapter="{{ loop.index0 }}" src="{{ c.still.src | root(r) }}"
               {%- set ss1 = c.still.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %}
               sizes="{{ c.still.sizes }}" alt="" loading="lazy" decoding="async">
        {%- endfor %}
        </div>
        <div class="spk-chap__glow" aria-hidden="true"></div>

        <div class="spk-chap__inner">
          <h2 class="spk-chap__h" id="{{ block.id }}-h">{{ block.heading | inline() }}</h2>

          {%- set pr = placeStyle(block.railPlacement) | trim %}
          {% if pr | length %}<div class="place place--rail" style="{{ pr }}"><div class="place__inner">{% endif %}
          <div class="spk-chap__rail" role="tablist" aria-label="{{ block.railLabel }}">
            <i class="spk-chap__line" aria-hidden="true"></i>
            <b class="spk-chap__fill" aria-hidden="true"></b>
            <span class="spk-chap__dot" aria-hidden="true"></span>
          {%- for c in block.chapters %}
            <button type="button" class="spk-chap__tab{% if loop.first %} is-on{% endif %}" role="tab" id="{{ block.id }}-tab-{{ loop.index }}" style="--i:{{ loop.index0 }}"
                    aria-controls="{{ block.id }}-panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}"
                    data-tone="{{ c.tone }}"><i class="spk-chap__stop" aria-hidden="true"></i>{{ c.word | inline() }}</button>
          {%- endfor %}
          </div>
          {% if pr | length %}</div></div>{% endif %}

          <div class="spk-chap__chapters">
          {%- for c in block.chapters %}
            {%- set pc = placeStyle(c.placement) | trim %}
            <div class="spk-chap__chapter{% if loop.first %} is-live{% endif %}{% if pc | length %} is-placed{% endif %}" role="tabpanel" id="{{ block.id }}-panel-{{ loop.index }}" aria-labelledby="{{ block.id }}-tab-{{ loop.index }}" tabindex="0"
                 data-tone="{{ c.tone }}" data-spot="{{ c.spot }}">
              <div class="spk-chap__frame" aria-hidden="true"></div>
              {% if pc | length %}<div class="place place--word" style="{{ pc }}"><div class="place__inner">{% endif %}<p class="spk-chap__word">{{ c.word | inline() }}</p>{% if pc | length %}</div></div>{% endif %}
              {% if pc | length %}<div class="place place--text" style="{{ pc }}"><div class="place__inner">{% endif %}<p class="spk-chap__text">{{ c.text | inline('spk-chap__key') }}</p>{% if pc | length %}</div></div>{% endif %}
            </div>
          {%- endfor %}
          </div>
          <p class="spk-sr" id="{{ block.id }}-live" aria-live="polite" aria-atomic="true"></p>
        </div>
      </div>
    </div>
  </section>
