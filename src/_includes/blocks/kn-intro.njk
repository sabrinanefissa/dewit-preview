{%- from "dd.njk" import dd %}
  {# ==============================================================
       Keynotes opening: the heading and its lines, then the three talks
       as three isometric rooms in a row, then the open talk under them.
       The talks are read from the page's kn-talk blocks, in page order.
       Each room is the button for its talk (js/keynotes.js): its number
       and title always show; hover grows the room and brings up its one
       line; click, tap or Enter opens its talk under the row. One talk
       is open at a time, the first by default, on a light veil so its
       text keeps its contrast as the page darkens. Each talk carries the
       talk's id, so #lead-human and the other anchors open it.
       No script: every room in full colour and every talk shown, one
       under the other, each with its own title.
       ============================================================== #}
  {%- set talkList = page.blocks | talks %}
  <section class="kn-intro"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('deep') }}">
    <div class="kn-intro__in">
      <div class="kn-intro__head">
        <h1 class="kn-intro__h" id="{{ block.id }}-h">{{ block.heading | inline('kn-em') }}</h1>
        <div class="kn-intro__copy">
        {%- for para in block.lead %}
          <p class="kn-intro__lead">{{ para | inline() }}</p>
        {%- endfor %}
        {%- for para in block.more %}
          <p class="kn-intro__more">{{ para | inline() }}</p>
        {%- endfor %}
        </div>
      </div>
      {%- if talkList.length %}
      <div class="kn-rooms" data-kn-rooms>
        <ul class="kn-rooms__row" role="list" aria-label="{{ (block.roomsLabel or 'The three keynotes') | plain }}">
        {%- for t in talkList %}
          {%- set rm = t.room %}
          <li class="kn-room" style="--w: {{ (rm.width if rm and rm.width else 480) }}; --h: {{ (rm.height if rm and rm.height else 480) }}">
            <button type="button" class="kn-room__btn" id="{{ t.id }}-room" aria-controls="{{ t.id }}" aria-expanded="{{ 'true' if loop.first else 'false' }}">
              {%- if rm and rm.src %}
              {%- set ssR = rm.src | srcset(r) %}
              <span class="kn-room__art" aria-hidden="true">
                <img class="kn-room__base" src="{{ rm.src | root(r) }}"{% if ssR %} srcset="{{ ssR }}"{% endif %} sizes="(max-width: 767px) 80vw, 32vw" alt="" width="{{ rm.width or 480 }}" height="{{ rm.height or 480 }}" decoding="async"{% if loop.first %} fetchpriority="high"{% endif %}>
                <img class="kn-room__lit" src="{{ rm.src | root(r) }}"{% if ssR %} srcset="{{ ssR }}"{% endif %} sizes="(max-width: 767px) 80vw, 32vw" alt="" width="{{ rm.width or 480 }}" height="{{ rm.height or 480 }}" decoding="async">
              </span>
              {%- endif %}
              <span class="kn-room__label">
                <span class="kn-room__n" aria-hidden="true">{{ loop.index | pad2 }}</span>
                <span class="kn-room__t">{{ t.title | inline() }}{% if t.trademark %}<span class="tm">™</span>{% endif %}</span>
              </span>
              {%- if t.indexLine %}
              <span class="kn-room__s">{{ t.indexLine | inline() }}</span>
              {%- endif %}
            </button>
          </li>
        {%- endfor %}
        </ul>
        <i class="kn-rooms__dot" aria-hidden="true"></i>
        <div class="kn-rooms__rail" aria-hidden="true"><i class="kn-rooms__mark"></i></div>
      </div>
      <div class="kn-talks veil--light">
      {%- for t in talkList %}
        {%- set img = t.image %}
        <article class="kn-talk{% if loop.first %} is-open{% endif %}" id="{{ t.id }}" aria-labelledby="{{ t.id }}-h">
          <h2 class="kn-talk__h" id="{{ t.id }}-h"><span class="kn-talk__n" aria-hidden="true">{{ loop.index | pad2 }}</span> {{ t.title | inline() }}{% if t.trademark %}<span class="tm">™</span>{% endif %}</h2>
          {%- if img and img.src %}
          <div class="kn-talk__ph">
            <img src="{{ img.src | root(r) }}" {%- set ss1 = img.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %} sizes="(max-width: 767px) 100vw, 32vw" alt="{{ img.alt | inline() }}"{% if not loop.first %} loading="lazy"{% endif %} decoding="async"{% if img.position %} style="object-position: {{ img.position | plain }}"{% endif %}>
          </div>
          {%- endif %}
          <div class="kn-talk__main">
            {%- if t.subtitle %}
            <p class="kn-talk__sub">{{ t.subtitle | inline() }}</p>
            {%- endif %}
            <p class="kn-talk__premise">{{ t.premise | inline('kn-em') }}</p>
            <div class="kn-talk__formats">
              <h3 class="kn-talk__h3">{{ t.formatsHeading | inline() }}</h3>
              <ul class="kn-talk__fl">
              {%- for f in t.formats %}
                <li>{{ f | inline() }}</li>
              {%- endfor %}
              </ul>
            </div>
            {%- if t.bookLabel and t.id %}
            <a class="btn kn-talk__book" href="{{ ('book/?talk=' ~ t.id) | root(r) }}">{{ t.bookLabel | inline() }}<span class="kn-vh">: {{ t.title | plain }}{% if t.trademark %}™{% endif %}</span></a>
            {%- endif %}
            {%- if t.link and t.link.href %}
            <a class="textlink kn-talk__link" href="{{ t.link.href | root(r) }}">{{ t.link.label | inline() }}
              <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            {%- endif %}
          </div>
          <div class="kn-talk__outs">
            <h3 class="kn-talk__h3">{{ t.outcomesHeading | inline() }}</h3>
            <ul class="kn-talk__out">
            {%- for o in t.outcomes %}
              <li>{{ o | inline() }}</li>
            {%- endfor %}
            </ul>
            {%- call dd(t.detailsLabel or "The full description and who it’s for", t.id ~ '-more', 'kn-talk__dd') %}
            {%- for para in t.overview %}
            <p class="kn-talk__p">{{ para | inline() }}</p>
            {%- endfor %}
            {%- if t.outcomesNote %}
            <p class="kn-talk__p">{{ t.outcomesNote | inline() }}</p>
            {%- endif %}
            <h4 class="kn-talk__h3 kn-talk__aud-h">{{ t.audienceHeading | inline() }}</h4>
            <p class="kn-talk__p">{{ t.audience | inline() }}</p>
            {%- endcall %}
          </div>
        </article>
      {%- endfor %}
      </div>
      {%- endif %}
    </div>
  </section>
