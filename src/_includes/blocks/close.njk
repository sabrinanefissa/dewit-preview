{%- from "place.njk" import placeStyle %}
  <div class="spk-close" aria-hidden="false">
    <img class="spk-close__img" src="{{ block.image.src | root(r) }}" {%- set ss1 = block.image.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %} sizes="{{ block.image.sizes }}" alt="" loading="lazy" decoding="async">
    <div class="spk-close__veil" aria-hidden="true"></div>
    {%- set ps = placeStyle(block.placement) | trim %}
    {% if ps | length %}<div class="place" style="{{ ps }}"><div class="place__inner">{% endif %}
    <div class="spk-close__inner">
      <h2 class="spk-close__h">{{ block.heading | inline() }}</h2>
      <a class="btn spk-close__cta" href="{{ block.cta.href | root(r) }}">{{ block.cta.label | inline() }}</a>
    </div>
    {% if ps | length %}</div></div>{% endif %}
  </div>
