  {# ==============================================================
       What the room is carrying: one stage photo (block.photo) held
       full screen behind the section while the heading, the lines (each
       with the talk that answers it and a button that plays the reel
       from its chapter, [data-seek] in js/main.js), the paragraph and the
       link to the keynotes scroll over the dark curtain on the right.
       ============================================================== #}
  {%- set chs = [] %}
  {%- for b in page.blocks %}{% if b.type == 'reelHero' and b.enabled !== false and b.chapters %}{% set chs = b.chapters.items %}{% endif %}{% endfor %}
  {%- set ph = block.photo or {} %}
  <section class="spk-unsaid"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-scheme="dark">
    {%- if ph.src %}
    <div class="spk-unsaid__bg">
      <img class="spk-unsaid__img" src="{{ ph.src | root(r) }}" {%- set ss1 = ph.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}" sizes="100vw"{% endif %} alt="{{ (ph.alt or '') | plain }}" loading="lazy" decoding="async">
    </div>
    {%- endif %}
    <div class="spk-unsaid__body">
      <h2 class="spk-h2 spk-unsaid__h" id="{{ block.id }}-h">{{ block.heading | inline('spk-em') }}</h2>
      <ol class="spk-rows">
      {%- for l in block.lines %}
        <li class="spk-row"><span class="spk-row__t">{{ l.text | inline('spk-em') }}</span>
        {%- if (l.talk and l.talk.href) or (l.time is defined) %}
          <span class="spk-row__ans">
          {%- if l.talk and l.talk.href %}{{ (block.answeredLabel or 'Answered in:') | inline() }} <a class="spk-row__talk" href="{{ l.talk.href | root(r) }}">{{ l.talk.label | inline() }}</a>{% endif %}
          {%- if l.time is defined %}
            {%- set chl = '' %}
            {%- for c in chs %}{% if c.time == l.time %}{% set chl = c.label %}{% endif %}{% endfor %}
            <button type="button" class="spk-row__play" data-seek="{{ l.time }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg><span class="spk-sr">{{ (block.stillLabel or 'Play the reel from') | plain }} </span><span class="spk-sr spk-chapters__t">{{ chl | plain }}</span></button>
          {%- endif %}</span>
        {%- endif %}</li>
      {%- endfor %}
      </ol>
      {%- if block.text %}
      <p class="spk-unsaid__p">{{ block.text | inline() }}</p>
      {%- endif %}
      {%- if block.link and block.link.href %}
      <a class="textlink spk-unsaid__link" href="{{ block.link.href | root(r) }}">{{ block.link.label | inline() }}
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {%- endif %}
    </div>
  </section>
