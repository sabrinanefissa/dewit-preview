{%- from "dd.njk" import dd %}
  {# ==============================================================
       What the room is carrying: the unsaid lines with five frames from
       the reel. The first line leads, its frame beside it at full size;
       three frames follow in a row; the line without a frame is set
       large beside the last frame, the turn. A frame is a button that
       plays the reel from the chapter it was taken from ([data-seek],
       js/main.js module 1); with no script it shows as a plain picture.
       js/speaking.js develops the frames as they arrive. Under them, the
       paragraph in a drop-down and the link to the keynotes.
       ============================================================== #}
  {%- set chs = [] %}
  {%- for b in page.blocks %}{% if b.type == 'reelHero' and b.enabled !== false and b.chapters %}{% set chs = b.chapters.items %}{% endif %}{% endfor %}
  <section class="spk-unsaid"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h">
    <div class="spk-unsaid__roll">
      <h2 class="spk-unsaid__h" id="{{ block.id }}-h">{{ block.heading | inline('spk-em') }}</h2>
      <ul class="spk-unsaid__lines">
      {%- for l in block.lines %}
        {%- set lt = l.text if l.text else l %}
        {%- set st = l.still if (l.still and l.still.src) else null %}
        <li class="{{ 'has-still' if st else 'no-still' }}">
        {%- if st %}
          {%- set chl = '' %}
          {%- for c in chs %}{% if c.time == st.time %}{% set chl = c.label %}{% endif %}{% endfor %}
          {%- set ss1 = st.src | srcset(r) %}
          <button type="button" class="spk-still" data-scheme="dark" data-seek="{{ st.time }}"><span class="spk-sr">{{ (block.stillLabel or 'Play the reel from') | plain }} </span><span class="spk-sr spk-chapters__t">{{ (chl or st.alt) | plain }}</span><span class="spk-sr">: </span><img class="spk-still__img" src="{{ st.src | root(r) }}"{% if ss1 %} srcset="{{ ss1 }}" sizes="(max-width: 700px) 92vw, 480px"{% endif %} width="480" height="360" alt="{{ st.alt | plain }}" loading="lazy" decoding="async"><span class="spk-still__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span></button>
        {%- endif %}
          <span class="spk-unsaid__t">{{ lt | inline('spk-em') }}</span>
        {%- if l.talk and l.talk.href %}
          <span class="spk-unsaid__ans">{{ (block.answeredLabel or 'Answered in:') | inline() }} <a class="spk-unsaid__talk" href="{{ l.talk.href | root(r) }}">{{ l.talk.label | inline() }}</a></span>
        {%- endif %}</li>
      {%- endfor %}
      </ul>
    </div>
    <div class="spk-unsaid__after">
      {%- if block.text %}
      {%- call dd(block.textLabel or 'What he does with them in the room', block.id ~ '-room', 'spk-unsaid__dd') %}
      <p>{{ block.text | inline() }}</p>
      {%- endcall %}
      {%- endif %}
      {%- if block.link and block.link.href %}
      <a class="textlink spk-unsaid__link" href="{{ block.link.href | root(r) }}">{{ block.link.label | inline() }}
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {%- endif %}
    </div>
  </section>
