  {# ==============================================================
       What he talks about: the unsaid lines as plain editorial text on
       plum, one real audience photo beside them, one short paragraph and
       a link to the keynotes. Under a line with a matching talk: "Answered
       in: <talk>", a plain link to that talk on the keynotes page. No motion.
       ============================================================== #}
  <section class="spk-unsaid"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('plum') }}">
    <div class="spk-unsaid__grid">
      <h2 class="spk-unsaid__h" id="{{ block.id }}-h">{{ block.heading | inline('spk-em') }}</h2>
      <ul class="spk-unsaid__lines">
      {%- for l in block.lines %}
        {%- set lt = l.text if l.text else l %}
        <li><span class="spk-unsaid__t">{{ lt | inline('spk-em') }}</span>
        {%- if l.talk and l.talk.href %}
          <span class="spk-unsaid__ans">{{ (block.answeredLabel or 'Answered in:') | inline() }} <a class="spk-unsaid__talk" href="{{ l.talk.href | root(r) }}">{{ l.talk.label | inline() }}</a></span>
        {%- endif %}</li>
      {%- endfor %}
      </ul>
      {%- if block.image and block.image.src %}
      <figure class="spk-unsaid__fig">
        <div class="media spk-unsaid__media">
          {%- set pp = block.image.src | portrait(r) %}{% if pp %}<picture class="pic"><source media="(max-width: 768px) and (orientation: portrait)" srcset="{{ pp }}" sizes="100vw">{% endif %}<img src="{{ block.image.src | root(r) }}"
               {%- set ss1 = block.image.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %}
               sizes="{{ block.image.sizes or '(max-width: 768px) 100vw, 38vw' }}" alt="{{ block.image.alt | inline() }}" loading="lazy" decoding="async">{% if pp %}</picture>{% endif %}
        </div>
        {%- if block.image.caption %}
        <figcaption class="spk-unsaid__cap">{{ block.image.caption | inline() }}</figcaption>
        {%- endif %}
      </figure>
      {%- endif %}
      <div class="spk-unsaid__after">
        <p class="spk-unsaid__p">{{ block.text | inline() }}</p>
        {%- if block.link and block.link.href %}
        <a class="textlink spk-unsaid__link" href="{{ block.link.href | root(r) }}">{{ block.link.label | inline() }}
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif %}
      </div>
    </div>
  </section>
