  <!-- Keynotes -->
  <section class="keynotes-sec"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} data-tone="{{ block | tone('plum-2') }}" data-follow="{{ block | motion('follow', 0.18) }}" data-fade="{{ block | motion('fade', 220) }}">
    <div class="keynotes-head reveal">
      <h2 class="h-md fill"{{ block.heading | fillAttrs }}>{{ block.heading | fillWords }}</h2>
    </div>
    <div class="keynotes">
    <!-- the panel: no box on wide fine-pointer screens (its CTA is the
         row's third column and, stretched, the whole row's link); on
         phones a block under the title (picture, sub, CTA), a
         disclosure on coarse pointers (js module 10.C) -->
    {%- for k in block.cards %}
      {%- set rid = block.id ~ '-row-' ~ loop.index %}
      <div class="keynote reveal" style="--_acc:var(--{{ k.accent }})">
        <span class="keynote__img" aria-hidden="true"><img src="{{ k.image.src | root(r) }}" {%- set ss1 = k.image.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %} sizes="{{ k.image.sizes or '100vw' }}" alt="" loading="lazy"></span>
        <span class="keynote__no">{{ loop.index | pad2 }}</span>
        <span class="keynote__main">
        {%- if k.tag %}
          <span class="keynote__tag">{{ k.tag | inline() }}</span>
        {%- endif %}
          <button type="button" class="keynote__title" id="{{ rid }}-t" aria-expanded="true" aria-controls="{{ rid }}" tabindex="-1">{% if k.titleHtml %}{{ k.titleHtml | safe }}{% else %}{{ k.title | inline() }}{% endif %}</button>
          <span class="keynote__sub">{{ k.sub | inline() }}</span>
          <span class="keynote__accent"></span>
        </span>
        <span class="keynote__panel" id="{{ rid }}">
          <span class="keynote__pic" aria-hidden="true">
            {%- set pp = k.image.src | portrait(r) %}{% if pp %}<picture class="pic"><source media="(max-width: 768px) and (orientation: portrait)" srcset="{{ pp }}" sizes="100vw">{% endif %}<img src="{{ k.image.src | root(r) }}" {%- if ss1 %} srcset="{{ ss1 }}"{% endif %} sizes="{{ k.image.sizes or '100vw' }}" alt="" loading="lazy" decoding="async">{% if pp %}</picture>{% endif %}</span>
          <a class="keynote__cta" id="{{ rid }}-cta" href="{{ k.href | root(r) }}" aria-labelledby="{{ rid }}-cta {{ rid }}-t"><span>{{ block.ctaLabel | inline() }}</span> <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </span>
      </div>
    {%- endfor %}
    </div>
    <!-- the hover picture (fine pointers only, js module 10.B): one per
         section, its src swapped to the hovered talk's image -->
    <img class="keynotes__float" src="{{ block.cards[0].image.src | root(r) }}" alt="" aria-hidden="true" decoding="async" loading="lazy" hidden>
  </section>
