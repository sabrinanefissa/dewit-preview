{%- from "place.njk" import placeStyle %}
  <!-- ==============================================================
       5. FORMATS - the sentence, then six rooms in a strip the scroll moves
       ============================================================== -->
  <section class="spk-formats"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-label="{{ block.ariaLabel | inline() }}" data-tone="{{ block | tone('transparent') }}">
    <div class="spk-formats__track">
      <div class="spk-formats__stage">
        {%- set ps = placeStyle(block.placement) | trim %}
        {% if ps | length %}<div class="place" style="{{ ps }}"><div class="place__inner">{% endif %}<p class="spk-formats__line reveal">{{ block.sentence | inline() }}</p>{% if ps | length %}</div></div>{% endif %}
        <h2 class="spk-formats__h">{{ block.heading | inline() }}</h2>
        <ul class="spk-formats__strip">
        {%- for room in block.rooms %}
          <li class="spk-formats__room"><img src="{{ room.image.src | root(r) }}" {%- set ss1 = room.image.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %} sizes="{{ block.sizes }}" alt="" loading="lazy" decoding="async"><span>{{ room.caption | inline() }}</span></li>
        {%- endfor %}
        </ul>
      </div>
    </div>
  </section>
