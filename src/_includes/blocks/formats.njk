  {# ==============================================================
       Rooms he speaks to: the formats sentence set as one large
       statement in its own short section, then the heading and the
       event types as full-width rows. Each row is the event, a hairline leader, then "usually:"
       and the talk booked for it; the whole row is the talk's link.
       js/speaking.js lights the rows in story order as they arrive.
       ============================================================== #}
  {%- if block.sentence %}
  <section class="spk-fmt-line" aria-label="{{ block.sentence | plain }}">
    <p class="spk-events__line">{{ block.sentence | inline() }}</p>
  </section>
  {%- endif %}
  {%- if block.events and block.events.length %}
  <section class="spk-formats spk-events"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h">
    <div class="spk-events__wrap">
      <h2 class="spk-events__h" id="{{ block.id }}-h">{{ block.heading | inline() }}</h2>
      <table class="spk-events__table">
        <thead class="spk-sr"><tr><th scope="col">{{ (block.eventsLabel or 'Event') | inline() }}</th><th scope="col">{{ (block.talkLabel or 'Talk') | inline() }}</th></tr></thead>
        <tbody>
        {%- for e in block.events %}
          <tr>
            <th scope="row"><span class="spk-events__name">{{ e.label | inline() }}</span></th>
            <td><span class="spk-events__usually">{{ (block.usuallyLabel or 'usually:') | inline() }}</span> {% if e.talk.href %}<a class="spk-events__talk" href="{{ e.talk.href | root(r) }}">{{ e.talk.label | inline() }}<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{% else %}<span class="spk-events__talk">{{ e.talk.label | inline() }}</span>{% endif %}</td>
          </tr>
        {%- endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {%- endif %}
