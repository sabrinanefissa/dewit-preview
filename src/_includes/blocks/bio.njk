  <!-- ==============================================================
       D. THE DIPTYCH - the suit portrait, sticky on the left, and on the
       right the smallest true introduction (one sentence, one link to the
       About page) followed by "For planners.": no boxes, no icons, just a
       centred column of text. The portrait stays on screen while the right
       column scrolls past and drifts slightly upward as it goes. The stage
       introduction Stephen supplies is held back: it addresses leaders
       three times and sits outside the approved category, so no control
       for it ships until he approves a revised text.
       ============================================================== -->
  <section class="spk-bio"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('transparent') }}" data-drift="{{ block | motion('drift', 0.04) }}">
    <div class="spk-bio__grid">
      <div class="spk-bio__left">
        <div class="media media--plum spk-bio__portrait">
          <img class="spk-lights" src="{{ block.portrait.src | root(r) }}"
               {%- set ss1 = block.portrait.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %}
               sizes="{{ block.portrait.sizes }}" alt="{{ block.portrait.alt | inline() }}" loading="lazy" decoding="async">
        </div>
      </div>
      <div class="spk-bio__right">
        <p class="spk-bio__line reveal">{{ block.line | inline() }}</p>
        <a class="textlink spk-bio__link reveal" href="{{ block.link.href | root(r) }}">{{ block.link.label | inline() }}
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

        <h2 class="spk-plan__h reveal" id="{{ block.id }}-h">{{ block.plannersHeading | inline() }}</h2>

        <div class="spk-plan__block reveal">
          <h3 class="spk-plan__label">{{ block.outcomesLabel | inline() }}</h3>
          <dl class="spk-plan__outs">
          {%- for o in block.outcomes %}
            <dt>{% if o.titleHtml %}{{ o.titleHtml | safe }}{% else %}{{ o.title | inline() }}{% endif %}</dt>
            <dd>{{ o.text | inline() }}</dd>
          {%- endfor %}
          </dl>
        </div>

        <div class="spk-plan__block reveal">
          <h3 class="spk-plan__label">{{ block.tailoringLabel | inline() }}</h3>
          <p class="spk-plan__copy">{{ block.tailoring | inline() }}</p>
        </div>

        <div class="spk-plan__block reveal">
          <h3 class="spk-plan__label">{{ block.onDayLabel | inline() }}</h3>
          <ul class="spk-plan__list">
          {%- for item in block.onDay %}
            <li>{{ item | inline() }}</li>
          {%- endfor %}
          </ul>
        </div>
      </div>
    </div>
  </section>
