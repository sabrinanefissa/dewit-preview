  <!-- ==============================================================
       3. KEYNOTES - a pinned stage. The track is 440svh; the stage
       inside it is sticky for 340svh of scroll. The section rises over
       the last 60svh of the candle wheel's stage, and its full-bleed
       ground fades in over the first 60svh of its own scroll, out of
       the wheel's wax close-up. Phases:
         0-50     the heading alone over the full-bleed ground (it takes
                  over, in place, from the candle wheel's copy)
         50-130   talk 01
         130-210  talk 02 wipes in from the right
         210-290  talk 03 wipes in from the right
         290-340  hold, while the room section rises over the stage
       Each talk is one full-screen picture carrying only its title and
       its one line, with one play ring under them (bottom-left). "Hear
       Stephen on this" plays that talk's segment of the reel with sound,
       full-bleed, on the one shared <video> above the pictures. The
       three panel pictures are placeholders: the reel stills at 1:50 /
       2:06 / 2:24 replace them once exported.
       The segment for each talk lives on its own button as
       data-seg-start / data-seg-end (seconds into the reel), so a re-cut
       is an edit here and nowhere else. The outcomes of each talk are
       listed under "For planners".
       Phones: no pin, a horizontal snap strip of the three talks.
       Reduced motion and no script: the three talks stacked.
       ============================================================== -->
  {%- set head = block | motion('head', 50) %}{% set panel = block | motion('panel', 80) %}
  <section class="spk-keys"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('transparent') }}" data-head="{{ head }}" data-panel="{{ panel }}" style="--panels:{{ block.talks.length }};--head-svh:{{ head }};--panel-svh:{{ panel }}">
    <div class="spk-keys__track">
      <div class="spk-keys__stage">
        <div class="spk-keys__ground">
          <img class="spk-keys__rest" src="{{ block.rest.src | root(r) }}"
               {%- set ss1 = block.rest.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %}
               sizes="{{ block.rest.sizes }}" alt="" loading="lazy" decoding="async">
          <div class="spk-keys__panels">
          {%- for t in block.talks %}
            <div class="spk-keys__panel{% if loop.first %} is-on{% endif %}" role="tabpanel" id="{{ block.id }}-panel-{{ loop.index }}" data-accent="{{ t.accent }}" aria-labelledby="{{ block.id }}-tab-{{ loop.index }}" tabindex="0">
              <img class="spk-keys__still" src="{{ t.image.src | root(r) }}"
                   {%- set ss2 = t.image.src | srcset(r) %}{% if ss2 %} srcset="{{ ss2 }}"{% endif %}
                   sizes="{{ t.image.sizes }}" alt="" loading="lazy" decoding="async">
              <div class="spk-keys__caption">
                <h3 class="spk-keys__ptitle">{% if t.titleHtml %}{{ t.titleHtml | safe }}{% else %}{{ t.title | inline() }}{% endif %}</h3>
                <p class="spk-keys__sub">{{ t.sub | inline() }}</p>
                <button type="button" class="spk-keys__hear" data-state="play"
                        data-seg-start="{{ t.segment.start }}" data-seg-end="{{ t.segment.end }}" data-seg-poster="{{ t.segment.poster }}" aria-pressed="false">
                  <span class="play__ring" aria-hidden="true">
                    <svg class="spk-ic spk-ic--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    <svg class="spk-ic spk-ic--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"/></svg>
                  </span>
                  <span class="spk-keys__hearlabel">{{ block.hearLabel | inline() }}</span>
                </button>
              </div>
            </div>
{% endfor %}
          </div>
        </div>
        <!-- One shared element for all three talks, separate from the hero's.
             Same reel, same encodes; the script assigns the src. It is
             only seen while a talk plays. -->
        <video class="spk-keys__video" playsinline muted preload="metadata"
               data-src-1080="{{ block.video.src1080 | root(r) }}"
               data-src-mobile="{{ block.video.srcMobile | root(r) }}">
          <track kind="captions" srclang="{{ block.captions.srclang }}" label="{{ block.captions.label }}" src="{{ block.captions.src | root(r) }}">
        </video>
        <div class="spk-keys__head">
          <h2 id="{{ block.id }}-h">{{ block.heading | inline() }}</h2>
        </div>
        <div class="spk-keys__index" role="tablist" aria-label="{{ block.indexLabel }}">
        {%- for t in block.talks %}
          <button type="button" class="spk-keys__tab{% if loop.first %} is-on{% endif %}" role="tab" id="{{ block.id }}-tab-{{ loop.index }}" data-accent="{{ t.accent }}" aria-controls="{{ block.id }}-panel-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">
            <span class="spk-keys__no">{{ loop.index | pad2 }}</span><span class="spk-keys__name">{% if t.titleHtml %}{{ t.titleHtml | safe }}{% else %}{{ t.title | inline() }}{% endif %}</span>
          </button>
        {%- endfor %}
        </div>
        <div class="spk-keys__play" aria-hidden="true">
          <p class="spk-keys__cap"></p>
        </div>
        <button type="button" class="spk-keys__pause" aria-label="{{ block.pauseLabel }}" hidden>
          <span class="play__ring" aria-hidden="true"><svg class="spk-ic spk-ic--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"/></svg></span>
        </button>
        <p class="spk-sr" id="{{ block.id }}-live" aria-live="polite" aria-atomic="true"></p>
      </div>
    </div>
  </section>
