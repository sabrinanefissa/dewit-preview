  <section class="spk-out"{% if block.id %} id="{{ block.id }}"{% endif %} aria-labelledby="spkOutH">
    <div class="media media--plum spk-out__media" aria-hidden="true">
      <img class="spk-lights" src="{{ block.image.src | root(r) }}"
           srcset="{{ block.image.srcset | srcset(r) }}"
           sizes="{{ block.image.sizes }}" alt="" loading="lazy" decoding="async">
    </div>
    <div class="spk-out__inner">
      <h2 class="spk-out__h" id="spkOutH">{{ block.heading | safe }}</h2>
      <ul class="spk-out__list">
      {%- for w in block.words %}
        <li class="spk-out__word spk-out__word--{{ w.layer }}"{% if w.layer == 'back' %} {% endif %} style="--x:{{ w.x }};--y:{{ w.y }}"><span class="spk-out__t">{{ w.text | safe }}</span></li>
      {%- endfor %}
      </ul>
    </div>
  </section>
