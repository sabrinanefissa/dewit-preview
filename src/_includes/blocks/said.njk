{%- from "place.njk" import placeStyle %}
  <!-- ==============================================================
       A. WHAT HE TALKS ABOUT - the candle wheel. A pinned stage over
       velvet: a wheel stands on its edge below the screen, six candles
       40 degrees apart on its rim, the top one standing on the bottom
       edge. The top candle is lit and its line stands above its flame;
       each 80svh of scroll turns the wheel one step, the candle that
       spoke stays lit as it goes under. On the last beats all six are
       lit. Then "Three talks." comes up large behind the candle while it
       is still at rest; as the candle starts to grow it rolls up and out
       of an invisible window while "for people, teams and
       organizations." rolls up into the same window, in front of the
       candle; the candle grows into its wax, the wax close-up settles, and the three talks rise over it (two
       visual lines, aria-hidden; the real heading is in the talks
       section). The track is 720svh:
         0-480    six beats, one line each (the sixth is the bridge)
         480-560  every candle lit, the bridge holds
         560-660  the grow: line A, the push into the wax, line B, the macro
         660-720  hold, while the talks section rises over the stage
       The six lines are real text in reading order at all times; the
       wheel is a decorative canvas. Reduced motion, Save-Data and no
       script: no pin, the six lines stacked (with script, each under a
       lit candle) on the velvet.
       ============================================================== -->
  {%- set beat = block | motion('beat', 80) %}{% set grow = block | motion('grow', 100) %}
  <section class="spk-said"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('plum-2') }}" data-beat="{{ beat }}" data-grow="{{ grow }}" style="--beats:{{ block.lines.length }};--beat:{{ beat }};--grow:{{ grow }}">
    <div class="spk-said__track">
      <div class="spk-said__stage">
        <img class="spk-said__velvet" src="{{ block.velvet.src | root(r) }}" {%- set ss1 = block.velvet.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %} sizes="{{ block.velvet.sizes }}" alt="" loading="lazy" decoding="async">
        <div class="spk-said__veil" aria-hidden="true"></div>
        {%- set pw = placeStyle(block.windowPlacement) | trim %}
        {% if pw | length %}<div class="place place--win-a" style="{{ pw }}"><div class="place__inner">{% endif %}<div class="spk-said__win spk-said__win--a" aria-hidden="true"><p class="spk-said__nextA">{{ block.windowA | inline('spk-said__cur') }}</p></div>{% if pw | length %}</div></div>{% endif %}
        <canvas class="spk-said__wheel" aria-hidden="true"></canvas>
        <img class="spk-said__macro" src="{{ block.macro | root(r) }}" alt="" loading="lazy" decoding="async">
        <div class="spk-said__bloom" aria-hidden="true"></div>
        {% if pw | length %}<div class="place place--win-b" style="{{ pw }}"><div class="place__inner">{% endif %}<div class="spk-said__win spk-said__win--b" aria-hidden="true"><p class="spk-said__nextB">{{ block.windowB | inline('spk-said__cur') }}</p></div>{% if pw | length %}</div></div>{% endif %}
        <div class="spk-said__inner">
          {%- set ph = placeStyle(block.headingPlacement) | trim %}
          {% if ph | length %}<div class="place place--h" style="{{ ph }}"><div class="place__inner">{% endif %}<h2 class="spk-said__h" id="{{ block.id }}-h">{{ block.heading | inline() }}</h2>{% if ph | length %}</div></div>{% endif %}
          {%- set pl = placeStyle(block.linesPlacement) | trim %}
          {% if pl | length %}<div class="place place--lines" style="{{ pl }}"><div class="place__inner">{% endif %}
          <div class="spk-said__lines">
          {%- for line in block.lines %}
            <p class="spk-said__line{% if loop.last %} spk-said__bridge{% endif %}" data-beat="{{ loop.index }}"><span class="spk-said__no">{{ loop.index | pad2 }}</span>{{ line | inline() }}</p>
          {%- endfor %}
          </div>
          {% if pl | length %}</div></div>{% endif %}
          <p class="spk-sr" id="{{ block.id }}-live" aria-live="polite" aria-atomic="true"></p>
        </div>
      </div>
    </div>
  </section>
