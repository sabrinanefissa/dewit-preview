{%- from "dd.njk" import dd %}
  {# ==============================================================
       For planners, on a real stage curtain (block.photo) held behind
       the section. Left: the heading, the line with the email, and the
       downloads as press-kit rows (the AV requirements row carries "AV
       at a glance" as its detail). Right: the three headshots (each a
       download, its name and size under it), then the bio (three
       lengths) and the stage introduction as drop-downs, each with its
       Copy button. Both columns end level. On phones: the line, the
       downloads, the headshots as a swipe row, then the bio, the
       introduction and AV as bottom sheets (js/speaking.js).
       ============================================================== #}
  {%- set copyIc %}<svg class="spk-copy__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="12" rx="1.5"/><path d="M15.5 8.5V5a1.5 1.5 0 0 0-1.5-1.5H6A1.5 1.5 0 0 0 4.5 5v10A1.5 1.5 0 0 0 6 16.5h2.5"/></svg><svg class="spk-copy__ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% endset %}
  {%- set ph = block.photo or {} %}
  <section class="spk-planners"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-scheme="dark">
    {%- if ph.src %}
    <div class="spk-planners__bg" aria-hidden="true">
      <img class="spk-planners__img" src="{{ ph.src | root(r) }}" {%- set ss1 = ph.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}" sizes="100vw"{% endif %} alt="" loading="lazy" decoding="async">
    </div>
    {%- endif %}
    <div class="spk-planners__main">
      <div class="spk-planners__left">
        <h2 class="spk-h2" id="{{ block.id }}-h">{{ block.heading | inline('spk-em') }}</h2>
        <p class="spk-planners__lead">{{ block.lead | inline() }}{% if block.contact and block.contact.href %}&nbsp;<a class="spk-planners__mail" href="{{ block.contact.href }}">{{ block.contact.label | inline() }}</a>{% endif %}</p>
        <div class="spk-kit" id="{{ block.id }}-downloads">
          <h3 class="spk-sr">{{ block.downloads.heading | inline() }}</h3>
          <ul class="spk-dl">
          {%- for d in block.downloads.items %}
            <li class="spk-dl__row">
              <a class="spk-dl__a" href="{{ d.file | root(r) }}" download>
                <span class="spk-dl__name">{{ d.label | inline() }}</span>
                <span class="spk-dl__meta">{{ d.format | inline() }}<span aria-hidden="true"> · </span><span class="spk-sr">, </span>{{ d.size | inline() }}</span>
                <svg class="spk-dl__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/></svg>
              </a>
              {%- if d.av and block.av %}
              {%- call dd(block.av.heading, block.id ~ '-av', 'spk-dd spk-dd--av') %}
              <ul class="spk-av">
              {%- for item in block.av.items %}
                <li>{{ item | inline() }}</li>
              {%- endfor %}
              </ul>
              {%- endcall %}
              {%- endif %}
            </li>
          {%- endfor %}
          </ul>
        </div>
      </div>

      <div class="spk-planners__right">
        <div class="spk-shots-wrap" id="{{ block.id }}-headshots">
          <h3 class="spk-sr">{{ block.headshots.heading | inline() }}</h3>
          <ul class="spk-shots" data-lenis-prevent>
          {%- for h in block.headshots.items %}
            <li class="spk-shot">
              {%- set ssT = h.thumb | srcset(r) %}
              <a class="spk-shot__a" href="{{ h.file | root(r) }}" download>
                <span class="spk-shot__frame"><img src="{{ h.thumb | root(r) }}"{% if ssT %} srcset="{{ ssT }}" sizes="(max-width: 767px) 62vw, 15vw"{% endif %} alt="" loading="lazy" decoding="async"></span>
                <span class="spk-shot__name">{{ h.label | inline() }}<span class="spk-sr">: {{ h.alt | plain }}</span></span>
                <span class="spk-shot__meta">{{ h.format | inline() }}<span aria-hidden="true"> · </span><span class="spk-sr">, </span>{{ h.size | inline() }}</span>
              </a>
            </li>
          {%- endfor %}
          </ul>
        </div>

        <div class="spk-texts">
          {%- call dd(block.bios.heading, block.id ~ '-bios', 'spk-dd spk-dd--bio') %}
          <div class="spk-pl" data-bios>
            <div class="spk-seg" role="group" aria-label="{{ block.bios.toggleLabel | inline() }}" hidden>
            {%- for b in block.bios.items %}
              <button type="button" class="spk-seg__btn" aria-pressed="{{ 'true' if loop.index == (block.bios.start or 1) else 'false' }}" aria-controls="{{ block.id }}-bio-{{ loop.index }}" data-bio="{{ loop.index }}">{{ b.label | inline() }}</button>
            {%- endfor %}
            </div>
            <div class="spk-pl__texts">
            {%- for b in block.bios.items %}
              <div class="spk-pl__text{% if loop.index == (block.bios.start or 1) %} is-on{% endif %}" id="{{ block.id }}-bio-{{ loop.index }}">
                <p class="spk-pl__label">{{ b.label | inline() }}{% if b.meta %}<span>{{ b.meta | inline() }}</span>{% endif %}</p>
                <p class="spk-pl__copytext">{{ b.text | inline() }}</p>
              </div>
            {%- endfor %}
            </div>
            <button type="button" class="spk-copy" data-copy-bio data-copied="{{ block.copiedLabel | inline() }}" hidden>{{ copyIc | safe }}<span class="spk-copy__label">{{ block.bios.copyLabel | inline() }}</span></button>
          </div>
          {%- endcall %}

          {%- call dd(block.intro.heading, block.id ~ '-stage', 'spk-dd spk-dd--intro') %}
          <div class="spk-pl">
            {%- if block.intro.note %}
            <p class="spk-pl__note">{{ block.intro.note | inline() }}</p>
            {%- endif %}
            <div class="spk-pl__intro" id="{{ block.id }}-intro">
            {%- for para in block.intro.paragraphs %}
              <p>{{ para | inline() }}</p>
            {%- endfor %}
            </div>
            <button type="button" class="spk-copy" data-copy="{{ block.id }}-intro" data-copied="{{ block.copiedLabel | inline() }}" hidden>{{ copyIc | safe }}<span class="spk-copy__label">{{ block.intro.copyLabel | inline() }}</span></button>
          </div>
          {%- endcall %}
        </div>
      </div>
    </div>

    <dialog class="spk-sheet spk-pl-sheet" id="{{ block.id }}-sheet" aria-labelledby="{{ block.id }}-sheet-h">
      <div class="spk-sheet__grab" aria-hidden="true"></div>
      <div class="spk-sheet__head">
        <h3 class="spk-sheet__h" id="{{ block.id }}-sheet-h"></h3>
        <button type="button" class="spk-sheet__close" data-sheet-close>{{ site.ui.drawerClose }}</button>
      </div>
      <div class="spk-sheet__body" data-lenis-prevent></div>
    </dialog>
    <p class="spk-sr" id="{{ block.id }}-live" aria-live="polite" aria-atomic="true"></p>
  </section>
