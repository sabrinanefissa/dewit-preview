  {# Same patterns: "How [Word] shows up." with the word as the live part;
       under it a rail of the seven words, then the word's two rooms side by
       side (phones: stacked), each with its label and line. js/home-rooms.js
       lights the home room, carries a light across, then lights the work
       room. Without the script the first word shows, both rooms lit. #}
  {%- set n = block.words.length %}
  <section class="patterns"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('plum') }}">
    <div class="patterns__inner">
      <h2 class="patterns__h" id="{{ block.id }}-h"><span class="patterns__how">{{ block.how | inline() }}</span> <span class="patterns__slot">
        {%- for w in block.words %}<span class="patterns__word{% if loop.first %} is-on{% endif %}" data-i="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>{{ w.name | plain }}</span>{% endfor -%}
      </span> <span class="patterns__tail">{{ block.tail | inline() }}</span></h2>

      <div class="patterns__nav">
        <button type="button" class="patterns__arrow patterns__arrow--prev" aria-label="{{ block.prevLabel }}" aria-controls="{{ block.id }}-rooms"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
        <div class="patterns__rail" role="group" aria-label="{{ block.ariaLabel | plain }}">
        {%- for w in block.words %}
          <button type="button" class="patterns__pick{% if loop.first %} is-on{% endif %}" data-i="{{ loop.index0 }}" aria-pressed="{{ 'true' if loop.first else 'false' }}" aria-controls="{{ block.id }}-rooms">{{ w.name | plain }}</button>
        {%- endfor %}
        </div>
        <button type="button" class="patterns__arrow patterns__arrow--next" aria-label="{{ block.nextLabel }}" aria-controls="{{ block.id }}-rooms"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>

      <div class="patterns__rooms" id="{{ block.id }}-rooms">
      {%- for room in [["home", block.homeLabel], ["work", block.workLabel]] %}
        <figure class="patterns__room patterns__room--{{ room[0] }}">
          <div class="patterns__art" aria-hidden="true">
          {%- for w in block.words %}
            {%- set src = w[room[0] + 'Img'] %}
            {%- set ss = src | srcset(r) %}
            <div class="patterns__pic{% if loop.first %} is-on{% endif %}" data-i="{{ loop.index0 }}">
              <img class="patterns__dim" src="{{ src | root(r) }}"{% if ss %} srcset="{{ ss }}"{% endif %} sizes="(max-width: 760px) 92vw, 42vw" alt="" width="1152" height="847"{% if not loop.first %} loading="lazy"{% endif %} decoding="async">
              <img class="patterns__lit" src="{{ src | root(r) }}"{% if ss %} srcset="{{ ss }}"{% endif %} sizes="(max-width: 760px) 92vw, 42vw" alt="" width="1152" height="847"{% if not loop.first %} loading="lazy"{% endif %} decoding="async">
            </div>
          {%- endfor %}
          </div>
          <figcaption class="patterns__cap">
            <span class="patterns__label">{{ room[1] }}</span>
            <span class="patterns__lines">
            {%- for w in block.words %}
              <span class="patterns__line{% if loop.first %} is-on{% endif %}" data-i="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>{{ w[room[0]] | inline() }}</span>
            {%- endfor %}
            </span>
          </figcaption>
        </figure>
      {%- endfor %}
        <i class="patterns__dot" aria-hidden="true"></i>
      </div>

      <p class="patterns__cta"><span class="patterns__cta-lead">{{ block.cta.lead | inline() }}</span>
        <a class="patterns__cta-link" href="{{ block.cta.href | root(r) }}">{{ block.cta.label | inline() }} <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>

      <p class="patterns__sr" id="{{ block.id }}-live" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>
