  {# Healthcare: what the room walks out with. On a veil, the heading and
       then the five outcomes as one row of small rooms (word.art), each
       outcome under its own room, the row stepping up and down. With
       js/healthcare.js (and motion allowed) the rooms start dim and light
       one after another, left to right, as the row scrolls up the screen,
       each word coming up with its room, once; a room lifts on hover.
       Without a picture a word stands on its own. #}
  <section class="hc-out"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('cream') }}">
    <div class="hc-out__inner veil veil--light">
      <h2 class="hc-out__h" id="{{ block.id }}-h">{{ block.heading | inline('hc-em') }}</h2>
      <ul class="hc-out__hub" data-hc-out>
      {%- for w in block.words %}
        <li class="hc-out__room" style="--k:{{ loop.index0 }}">
          {%- if w.art %}{% set oa = w.art | aspect %}
          <div class="hc-out__pic" aria-hidden="true">
            <img src="{{ w.art | root(r) }}"{% set ss = w.art | srcset(r) %}{% if ss %} srcset="{{ ss }}"{% endif %} sizes="(max-width: 760px) 44vw, 19vw" alt="" loading="lazy" decoding="async"{% if oa %} style="aspect-ratio:{{ oa }}"{% endif %}>
          </div>
          {%- endif %}
          <p class="hc-out__word">{{ w.text | inline() }}</p>
        </li>
      {%- endfor %}
      </ul>
    </div>
  </section>
