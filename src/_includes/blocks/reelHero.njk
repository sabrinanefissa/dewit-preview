{%- from "place.njk" import placeStyle %}
  {# ==============================================================
       1. HERO - full-screen reel, sound on a click only. No text over the
       frame: the reel carries its own on-screen titles, so only the three
       controls sit over it. The h1 and its line sit in the band directly
       under the reel (.spk-intro), with the reel's chapters.
       Swap the clip by editing the three data-src-* paths below and
       the poster; nothing else references the file. reel-mobile.mp4 is
       9.4 MB (<= 10 MB), so muted autoplay is allowed under 820px:
       that is what data-mobile-autoplay="true" states.
       ============================================================== #}
  <section class="hero spk-hero"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} data-parallax="{{ block | motion('parallax', 0.5) }}" data-dim="{{ block | motion('dim', 0.55) }}" data-name-morph="{{ block | motion('nameMorph', 0.4) }}">
    <div class="media media--plum">
      {%- set pp = block.poster.src | portrait(r) %}{% if pp %}<picture class="pic"><source media="(max-width: 768px) and (orientation: portrait)" srcset="{{ pp }}" sizes="100vw">{% endif %}<img class="hero__poster" src="{{ block.poster.src | root(r) }}"
           {%- set ss1 = block.poster.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}"{% endif %}
           sizes="{{ block.poster.sizes or '100vw' }}" alt="{{ block.poster.alt | inline() }}" fetchpriority="high">{% if pp %}</picture>{% endif %}
      <video class="spk-hero__video" playsinline muted preload="metadata"
             poster="{{ block.video.poster | root(r) }}"
             aria-label="{{ block.video.ariaLabel | inline() }}"
             data-src-1080="{{ block.video.src1080 | root(r) }}"
             data-src-720="{{ block.video.src720 | root(r) }}"
             data-src-mobile="{{ block.video.srcMobile | root(r) }}"
             data-mobile-autoplay="{{ block.video.mobileAutoplay }}">
        <track kind="captions" srclang="{{ block.captions.srclang }}" label="{{ block.captions.label }}" src="{{ block.captions.src | root(r) }}">
      </video>
    </div>

    {%- set band = block.line or (block.chapters and block.chapters.items and block.chapters.items.length) %}
    {%- if not band %}
    <h1 class="spk-sr">{{ block.heading | inline() }}</h1>
    {%- endif %}

    {# The one primary control: it is a speaking page, so the offer is the
         sound. One click unmutes, restarts the reel at 0:00 and plays; the
         button then fades out and comes back only when the reel ends, as
         "Replay with sound". The small controls below keep the rest; the
         play/pause control among them appears only once the reel has been
         started. #}
    {%- set ps = placeStyle(block.placement) | trim %}
    {% if ps | length %}<div class="place" style="{{ ps }}"><div class="place__inner">{% endif %}
    <button type="button" class="spk-hero__cta" data-state="start">
      <span class="play__ring" aria-hidden="true">
        <svg class="spk-ic spk-ic--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        <svg class="spk-ic spk-ic--replay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.5-5.8"/><path d="M4 4v4h4"/></svg>
      </span>
      <span class="spk-hero__cta-label">{{ block.labels.cta | inline() }}</span>
    </button>
    {% if ps | length %}</div></div>{% endif %}

    {# The voice line. Decorative: it is the reel's own audio drawn as one
         open line by an AnalyserNode. It is invisible while the reel is muted
         or paused — there is no idle line — and fades in only while sound is
         actually playing, directly above the control row. One static render
         under reduced motion or Save-Data; absent with no script. #}
    <canvas class="spk-voice" aria-hidden="true"></canvas>

    <div class="hero__actions spk-hero__controls">
        <button type="button" class="spk-ctrl" data-ctrl="play" data-state="play" aria-pressed="false" hidden>
          <span class="play__ring" aria-hidden="true">
            <svg class="spk-ic spk-ic--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            <svg class="spk-ic spk-ic--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"/></svg>
            <svg class="spk-ic spk-ic--replay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.5-5.8"/><path d="M4 4v4h4"/></svg>
          </span>
          <span class="spk-ctrl__label">{{ block.labels.play | inline() }}</span>
        </button>

        <button type="button" class="spk-ctrl" data-ctrl="sound" data-state="on" aria-pressed="false">
          <span class="play__ring" aria-hidden="true">
            <svg class="spk-ic spk-ic--sound" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9.5h3.2L12 5.4v13.2L7.2 14.5H4z" fill="currentColor" stroke="none"/><path d="M15.6 9a4.2 4.2 0 0 1 0 6"/><path d="M18.2 6.6a7.6 7.6 0 0 1 0 10.8"/></svg>
            <svg class="spk-ic spk-ic--mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9.5h3.2L12 5.4v13.2L7.2 14.5H4z" fill="currentColor" stroke="none"/><path d="M16 9.5l4.5 5M20.5 9.5l-4.5 5"/></svg>
          </span>
          <span class="spk-ctrl__label">{{ block.labels.sound | inline() }}</span>
        </button>

        <button type="button" class="spk-ctrl" data-ctrl="cc" data-state="off" aria-pressed="false">
          <span class="play__ring" aria-hidden="true">
            <svg class="spk-ic spk-ic--cc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M10 10.4a2.6 2.6 0 1 0 0 3.2"/><path d="M16.6 10.4a2.6 2.6 0 1 0 0 3.2"/></svg>
            <svg class="spk-ic spk-ic--cc-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M10 10.4a2.6 2.6 0 1 0 0 3.2"/><path d="M16.6 10.4a2.6 2.6 0 1 0 0 3.2"/><path d="M4.4 19.6L19.6 4.4"/></svg>
          </span>
          <span class="spk-ctrl__label">{{ block.labels.captions | inline() }}</span>
        </button>
    </div>

    <p class="spk-sr" id="{{ block.id }}-live" aria-live="polite" aria-atomic="true"></p>
  </section>
  {%- if band %}
  {# Under the reel: the page's h1 in plain sight with its one line, and
       the reel's chapters. Kept off the frame so the words never fight the
       reel's own titles. Each chapter is a button that plays the reel from
       that second with sound (js module 1, [data-seek]); with no script the
       list still reads as the reel's contents. Static: nothing animates. #}
  <section class="spk-intro" aria-labelledby="{{ block.id }}-h" data-tone="{{ block | tone('plum-2') }}">
    <div class="spk-intro__grid">
      <div class="spk-intro__head">
        <h1 class="spk-intro__h" id="{{ block.id }}-h">{{ block.heading | inline('spk-em') }}</h1>
        {%- if block.line %}
        <p class="spk-intro__line">{{ block.line | inline() }}</p>
        {%- endif %}
      </div>
      {%- set ch = block.chapters %}
      {%- if ch and ch.items and ch.items.length %}
      <div class="spk-chapters">
        <h2 class="spk-chapters__h" id="{{ block.id }}-ch">{{ ch.heading | inline() }}</h2>
        {%- if ch.note %}
        <p class="spk-chapters__note">{{ ch.note | inline() }}</p>
        {%- endif %}
        <ol class="spk-chapters__list" aria-labelledby="{{ block.id }}-ch">
        {%- for c in ch.items %}
          {%- set mm = (c.time / 60) | int %}{% set ss = c.time - mm * 60 %}
          <li><button type="button" class="spk-chapters__btn" data-seek="{{ c.time }}"><span class="spk-sr">Play from </span><time class="spk-chapters__time" datetime="PT{{ c.time }}S">{{ mm }}:{{ ss | pad2 }}</time><span class="spk-sr">: </span><span class="spk-chapters__t">{{ c.label | inline() }}</span></button></li>
        {%- endfor %}
        </ol>
      </div>
      {%- endif %}
    </div>
  </section>
  {%- endif %}
