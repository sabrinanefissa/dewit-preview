  {# ==============================================================
       1. HERO - a stage photo (block.photo: the wide one, and the tall one
       for phones) with the eyebrow, the h1, its line and the two buttons
       set in the stage dark, and the links to the page's sections as chips
       under them. Nothing moves at rest.
       "Play with sound" opens the reel in place, with sound: the photo
       gives way to the video and one slim bar along its foot carries the
       small controls, the chapters (a sheet) and Close. The photo returns
       when the reel is closed or ends (js/speaking.js).
       Swap the clip by editing the data-src-* paths and the poster.
       ============================================================== #}
  {%- set ch = block.chapters %}
  {%- set hasCh = ch and ch.items and ch.items.length %}
  {%- set chTitle = (ch.heading ~ ': ' ~ ch.items.length ~ ' ' ~ (ch.countLabel or 'chapters')) if hasCh else '' %}
  {%- set ph = block.photo or {} %}
  <section class="spk-hero"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h" data-scheme="dark">
    <picture class="spk-hero__photo">
      {%- if ph.phone %}<source media="(max-width: 767px)" srcset="{{ ph.phone | srcset(r) }}" sizes="100vw">{% endif %}
      <img src="{{ ph.src | root(r) }}" {%- set ss1 = ph.src | srcset(r) %}{% if ss1 %} srcset="{{ ss1 }}" sizes="120vw"{% endif %} alt="{{ (ph.alt or '') | plain }}" fetchpriority="high" decoding="async">
    </picture>

    <div class="spk-hero__reel" id="{{ block.id }}-reel">
      <video class="spk-hero__video" playsinline muted preload="none"
             poster="{{ block.video.poster | root(r) }}"
             aria-label="{{ block.video.ariaLabel | inline() }}"
             data-src-1080="{{ block.video.src1080 | root(r) }}"
             data-src-720="{{ block.video.src720 | root(r) }}"
             data-src-mobile="{{ block.video.srcMobile | root(r) }}"
             data-mobile-autoplay="{{ block.video.mobileAutoplay or 'false' }}">
        <track kind="captions" srclang="{{ block.captions.srclang }}" label="{{ block.captions.label }}" src="{{ block.captions.src | root(r) }}">
      </video>

      <div class="spk-bar">
        <div class="spk-hero__controls">
          <button type="button" class="spk-ctrl" data-ctrl="play" data-state="play" aria-pressed="false" hidden>
            <span class="play__ring" aria-hidden="true">
              <svg class="spk-ic spk-ic--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              <svg class="spk-ic spk-ic--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"/></svg>
              <svg class="spk-ic spk-ic--replay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.5-5.8"/><path d="M4 4v4h4"/></svg>
            </span>
            <span class="spk-ctrl__label">{{ block.labels.play | inline() }}</span>
          </button>

          <button type="button" class="spk-ctrl" data-ctrl="sound" data-state="on" aria-pressed="false">
            <span class="play__ring" aria-hidden="true">
              <svg class="spk-ic spk-ic--sound" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9.5h3.2L12 5.4v13.2L7.2 14.5H4z" fill="currentColor" stroke="none"/><path d="M15.6 9a4.2 4.2 0 0 1 0 6"/><path d="M18.2 6.6a7.6 7.6 0 0 1 0 10.8"/></svg>
              <svg class="spk-ic spk-ic--mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9.5h3.2L12 5.4v13.2L7.2 14.5H4z" fill="currentColor" stroke="none"/><path d="M16 9.5l4.5 5M20.5 9.5l-4.5 5"/></svg>
            </span>
            <span class="spk-ctrl__label">{{ block.labels.sound | inline() }}</span>
          </button>

          <button type="button" class="spk-ctrl" data-ctrl="cc" data-state="off" aria-pressed="false">
            <span class="play__ring" aria-hidden="true">
              <svg class="spk-ic spk-ic--cc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M10 10.4a2.6 2.6 0 1 0 0 3.2"/><path d="M16.6 10.4a2.6 2.6 0 1 0 0 3.2"/></svg>
              <svg class="spk-ic spk-ic--cc-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M10 10.4a2.6 2.6 0 1 0 0 3.2"/><path d="M16.6 10.4a2.6 2.6 0 1 0 0 3.2"/><path d="M4.4 19.6L19.6 4.4"/></svg>
            </span>
            <span class="spk-ctrl__label">{{ block.labels.captions | inline() }}</span>
          </button>

          {%- if hasCh %}
          <button type="button" class="spk-ctrl spk-bar__chap" aria-haspopup="dialog" aria-controls="{{ block.id }}-chapters">
            <span class="play__ring" aria-hidden="true">
              <svg class="spk-ic spk-ic--list" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 7h11M9 12h11M9 17h11"/><path d="M4.5 7h.01M4.5 12h.01M4.5 17h.01" stroke-width="2.4" stroke-linecap="round"/></svg>
            </span>
            <span class="spk-ctrl__label">{{ chTitle | inline() }}</span>
          </button>
          {%- endif %}
        </div>
        <button type="button" class="spk-bar__close" data-reel-close>{{ site.ui.drawerClose }}</button>
      </div>
    </div>

    <div class="spk-hero__copy">
      <div class="spk-hero__head">
        {%- if block.eyebrow %}
        <p class="spk-hero__eyebrow">{{ block.eyebrow | inline() }}</p>
        {%- endif %}
        <h1 class="spk-hero__h" id="{{ block.id }}-h">{{ block.heading | inline('spk-em') }}</h1>
        {%- if block.line %}
        <p class="spk-hero__line">{{ block.line | inline() }}</p>
        {%- endif %}
        <div class="spk-hero__ctas">
          {%- if block.cta and block.cta.href %}
          <a class="btn btn--lg spk-hero__book" href="{{ block.cta.href | root(r) }}">{{ block.cta.label | inline() }}</a>
          {%- endif %}
          <button type="button" class="btn btn--lg btn--inv spk-hero__cta" data-state="start" aria-controls="{{ block.id }}-reel">
            <svg class="spk-ic spk-ic--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            <svg class="spk-ic spk-ic--replay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.5-5.8"/><path d="M4 4v4h4"/></svg>
            <span class="spk-hero__cta-label">{{ block.labels.cta | inline() }}</span>
          </button>
        </div>
      </div>
      {%- if block.index and block.index.items and block.index.items.length %}
      <nav class="spk-index" aria-label="{{ (block.index.label or 'On this page') | plain }}">
        <ul class="spk-index__list">
        {%- for it in block.index.items %}
          <li><a class="spk-index__a" href="{{ it.href | root(r) }}">{{ it.label | inline() }}</a></li>
        {%- endfor %}
        </ul>
      </nav>
      {%- endif %}
    </div>

    <p class="spk-sr" id="{{ block.id }}-live" aria-live="polite" aria-atomic="true"></p>

    {%- if hasCh %}
    <dialog class="spk-sheet spk-chapters" id="{{ block.id }}-chapters" aria-labelledby="{{ block.id }}-chapters-h">
      <div class="spk-sheet__grab" aria-hidden="true"></div>
      <div class="spk-sheet__head">
        <h2 class="spk-sheet__h" id="{{ block.id }}-chapters-h">{{ chTitle | inline() }}</h2>
        <button type="button" class="spk-sheet__close" data-sheet-close>{{ site.ui.drawerClose }}</button>
      </div>
      <div class="spk-sheet__body" data-lenis-prevent>
        {%- if ch.note %}
        <p class="spk-chapters__note">{{ ch.note | inline() }}</p>
        {%- endif %}
        <ol class="spk-chapters__list" aria-label="{{ ch.heading | plain }}">
        {%- for c in ch.items %}
          {%- set mm = (c.time / 60) | int %}{% set ss = c.time - mm * 60 %}
          <li><button type="button" class="spk-chapters__btn" data-seek="{{ c.time }}"><span class="spk-sr">Play from </span><time class="spk-chapters__time" datetime="PT{{ c.time }}S">{{ mm }}:{{ ss | pad2 }}</time><span class="spk-sr">: </span><span class="spk-chapters__t">{{ c.label | inline() }}</span></button></li>
        {%- endfor %}
        </ol>
      </div>
    </dialog>
    {%- endif %}
  </section>
