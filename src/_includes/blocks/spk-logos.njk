  {# ==============================================================
       Where Stephen has spoken: the marks in two rows, no boxes, each
       in the section's text colour at one optical size (each logo's
       scale evens out its visual weight). Wide wordmarks take a full
       row on phones. js/speaking.js lands the marks in turn.
       ============================================================== #}
  <section class="spk-logos"{% if block.id and block.anchor !== false %} id="{{ block.id }}"{% endif %} aria-labelledby="{{ block.id }}-h">
    <h2 class="spk-logos__h" id="{{ block.id }}-h">{{ block.heading | inline('spk-em') }}</h2>
    <ul class="spk-logos__wall">
    {%- for logo in block.logos %}
      <li{% if logo.wide %} class="is-wide"{% endif %}><img src="{{ logo.src | root(r) }}" alt="{{ logo.alt | inline() }}"{% if logo.knockout %} data-knockout{% endif %}{% if logo.plate %} data-plate{% endif %} loading="lazy" decoding="async"{% if logo.scale %} style="--s:{{ logo.scale | plain }}"{% endif %}></li>
    {%- endfor %}
    </ul>
  </section>
