{%- set r = page.root -%}
{%- set slug = page.slug -%}
<!doctype html>
<html lang="{{ site.lang }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="{{ site.head.viewport }}">
<title>{{ page.title | safe }}</title>
<meta name="description" content="{{ page.description | safe }}">
<link rel="canonical" href="{{ page.canonical }}">
<meta property="og:type" content="{{ site.head.ogType }}">
<meta property="og:title" content="{{ page.og.title | safe }}">
<meta property="og:description" content="{{ page.og.description | safe }}">
<meta property="og:url" content="{{ page.og.url }}">
<meta property="og:image" content="{{ page.og.image }}">
<meta name="twitter:card" content="{{ site.head.twitterCard }}">
<link rel="icon" href="{{ site.head.favicon.href | root(r) }}" sizes="{{ site.head.favicon.sizes }}">
<link rel="apple-touch-icon" href="{{ site.head.appleTouchIcon | root(r) }}">
{%- for pc in site.head.preconnect %}
<link rel="preconnect" href="{{ pc.href }}"{% if pc.crossorigin %} crossorigin{% endif %}>
{%- endfor %}
<link href="{{ site.head.fonts | safe }}" rel="stylesheet">
{%- if page.preload %}
<link rel="preload" as="image" href="{{ page.preload.href | root(r) }}"{% if page.preload.srcset %} imagesrcset="{{ page.preload.srcset | srcset(r) }}" imagesizes="{{ page.preload.sizes }}"{% endif %} fetchpriority="high">
{%- endif %}
<link rel="stylesheet" href="{{ site.head.stylesheet | root(r) }}?v={{ build.v }}">
<script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>
{%- if page.jsonld %}
{%- set ps = site.person %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Person","name":{{ ps.name | dump | safe }},
"jobTitle":{{ ps.jobTitle | dump | safe }},
"description":{{ ps.description | dump | safe }},
"url":{{ ps.url | dump | safe }},"email":{{ site.contact.email | dump | safe }},"telephone":{{ ps.telephone | dump | safe }},
"knowsAbout":{{ ps.knowsAbout | dump | safe }},
"sameAs":[{% for s in site.socials %}{{ s.href | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{%- endif %}
</head>
<body>
<a class="skip" href="#main">{{ site.ui.skip }}</a>

<!-- {{ page.comments.loader | safe }} -->
<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__name"><span>{{ site.brand }}</span></div>
  <div class="loader__bar" id="loaderBar"></div>
</div>
<div class="grain" aria-hidden="true"></div>

<!-- {{ page.comments.nav | safe }} -->
<header class="nav" id="nav">
  {%- set bl = site.brandLink | navlink(slug, r) %}
  <a class="brand" href="{{ bl.href }}">{{ site.brand }}</a>
  <div class="nav-right">
    <nav class="nav-links" aria-label="{{ site.ui.navLabel }}">
    {%- for l in site.nav %}{% set nl = l | navlink(slug, r) %}
      <a href="{{ nl.href }}"{% if nl.current %} aria-current="page"{% endif %}>{{ l.label | safe }}</a>
    {%- endfor %}
    </nav>
    <a class="nav-cta" href="{{ site.cta.href | root(r) }}"><span>{{ site.cta.label | safe }}</span></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="drawer">{{ site.ui.menu }} <span class="bars"><i></i><i></i></span></button>
  </div>
</header>

<div class="drawer" id="drawer" aria-hidden="true">
  <button class="drawer__close" aria-label="{{ site.ui.drawerCloseLabel }}">{{ site.ui.drawerClose }}</button>
  <nav aria-label="{{ site.ui.drawerLabel }}">
    {% for l in site.nav %}{% set nl = l | navlink(slug, r) %}<a href="{{ nl.href }}"{% if nl.current %} aria-current="page"{% endif %}>{{ l.label | safe }}</a>{% endfor %}<a href="{{ site.cta.href | root(r) }}">{{ site.cta.label | safe }}</a>
  </nav>
  <div class="drawer__foot"><a href="tel:{{ site.contact.tel }}">{{ site.contact.phone }}</a><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></div>
</div>

<main id="main"{% if page.mainTabindex %} tabindex="{{ page.mainTabindex }}"{% endif %}>
{%- if page.ground %}
  <!-- The ground. One room under the whole page (a theatre from the back
       row) and a colour veil over it whose tone the scroll spine warms and
       cools as the page goes down. Every section that has no picture of its
       own is transparent, so the page has no bands; sections that ARE a
       picture (hero, the talks, the room, the walk-out) cover it. -->
  <div class="spk-ground" aria-hidden="true">
    <img class="spk-ground__img" src="{{ page.ground.image | root(r) }}"
         srcset="{{ page.ground.srcset | srcset(r) }}"
         sizes="{{ page.ground.sizes }}" alt="" decoding="async" fetchpriority="low">
    {%- if page.ground.veil %}
    <div class="spk-ground__veil"></div>
    {%- endif %}
  </div>
{%- endif %}
{% for b in page.blocks %}{% if b.enabled !== false and b.type != "close" %}{% set block = b %}
{% include "blocks/" + b.type + ".njk" %}
{% endif %}{% endfor %}
{%- if page.comments.mainEnd %}
  <!-- {{ page.comments.mainEnd | safe }} -->
{%- endif %}
</main>

<footer class="foot{% if page.footer and page.footer.class %} {{ page.footer.class }}{% endif %}"{% if page.footer and page.footer.id %} id="{{ page.footer.id }}"{% endif %}>
{%- for b in page.blocks %}{% if b.enabled !== false and b.type == "close" %}{% set block = b %}
{% include "blocks/close.njk" %}
{%- endif %}{% endfor %}
  <div class="foot__grid">
    <div>
      <span class="brand">{{ site.brand }}</span>
      <p style="{{ site.footer.blurbStyle }}">{{ site.footer.blurb | safe }}</p>
    </div>
    <div><h3>{{ site.footer.explore.heading }}</h3><ul>
      {%- for l in site.footer.explore.links %}{% set nl = l | navlink(slug, r) %}
      <li><a href="{{ nl.href }}"{% if nl.current %} aria-current="page"{% endif %}>{{ l.label | safe }}</a></li>
      {%- endfor %}</ul></div>
    <div><h3>{{ site.footer.connect.heading }}</h3><ul>
      <li><a href="tel:{{ site.contact.tel }}">{{ site.contact.phone }}</a></li><li><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
      {%- for s in site.socials %}
      <li><a href="{{ s.href }}" target="_blank" rel="noopener">{{ s.label }}</a></li>
      {%- endfor %}</ul></div>
  </div>
  <div class="foot__base"><span>© <span data-year>{{ site.year }}</span> {{ site.brand }}</span><span>{{ site.tagline | safe }}</span></div>
</footer>

{% if page.lightbox -%}
<div class="lb" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ site.lightbox.label }}">
  <button class="lb__close" aria-label="{{ site.lightbox.closeLabel }}">{{ site.lightbox.close }}</button>
  <div class="lb__frame">
    <div class="lb__placeholder">
      <p class="eyebrow">{{ site.lightbox.eyebrow }}</p>
      <p>{{ site.lightbox.text | safe }}</p>
      <p style="{{ site.lightbox.ctaStyle }}"><a class="btn btn--inv" href="{{ site.lightbox.cta.href | root(r) }}">{{ site.lightbox.cta.label | safe }}</a></p>
    </div>
  </div>
</div>

{% endif -%}
{% for s in page.scripts %}<script src="{{ s | root(r) }}?v={{ build.v }}" defer></script>
{% endfor %}<script src="{{ site.head.script | root(r) }}?v={{ build.v }}" defer></script>
</body>
</html>
