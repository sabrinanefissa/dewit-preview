{%- set r = page.root -%}
{%- set slug = page.slug -%}
{{- page | assertUniqueIds -}}
<!doctype html>
<html lang="{{ site.lang }}" class="no-js" data-page="{{ slug }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="{{ site.head.viewport }}">
{%- set tg = theme.pageGradients[slug] or theme.pageGradients.home %}
<meta name="theme-color" content="{{ tg[3] }}">
<script>(function (W) { var w = 0; function s() { if (W.innerWidth === w) return; w = W.innerWidth; document.documentElement.style.setProperty('--app-h', W.innerHeight + 'px'); } s(); W.addEventListener('resize', s); })(window);</script>
<title>{{ page.title | inline() }}</title>
<meta name="description" content="{{ page.description | inline() }}">
{%- if page.noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<link rel="canonical" href="{{ page.canonical }}">
<meta property="og:type" content="{{ site.head.ogType }}">
<meta property="og:title" content="{{ page.og.title | inline() }}">
<meta property="og:description" content="{{ page.og.description | inline() }}">
<meta property="og:url" content="{{ page.og.url }}">
<meta property="og:image" content="{{ page.og.image }}">
<meta name="twitter:card" content="{{ site.head.twitterCard }}">
<link rel="icon" href="{{ site.head.favicon.href | root(r) }}" sizes="{{ site.head.favicon.sizes }}">
<link rel="apple-touch-icon" href="{{ site.head.appleTouchIcon | root(r) }}">
{%- for pc in site.head.preconnect %}
<link rel="preconnect" href="{{ pc.href }}"{% if pc.crossorigin %} crossorigin{% endif %}>
{%- endfor %}
<link href="{{ site.head.fonts | inline() }}" rel="stylesheet">
{%- if page.preload %}
{%- set ss1 = page.preload.sizes and (page.preload.href | srcset(r)) %}
{%- set pp1 = page.preload.href | portrait(r) %}
<link rel="preload" as="image" href="{{ page.preload.href | root(r) }}"{% if ss1 %} imagesrcset="{{ ss1 }}" imagesizes="{{ page.preload.sizes or '100vw' }}"{% endif %}{% if pp1 %} media="not all and (max-width: 768px) and (orientation: portrait)"{% endif %} fetchpriority="high">
{%- if pp1 %}
<link rel="preload" as="image" imagesrcset="{{ pp1 }}" imagesizes="100vw" media="(max-width: 768px) and (orientation: portrait)" fetchpriority="high">
{%- endif %}
{%- endif %}
<link rel="stylesheet" href="{{ 'css/tokens.css' | root(r) }}?v={{ 'css/tokens.css' | stamp }}">
<link rel="stylesheet" href="{{ site.head.stylesheet | root(r) }}?v={{ site.head.stylesheet | stamp }}">
{% for s in page.styles %}<link rel="stylesheet" href="{{ s | root(r) }}?v={{ s | stamp }}">
{% endfor %}<link rel="stylesheet" href="{{ 'css/phone.css' | root(r) }}?v={{ 'css/phone.css' | stamp }}" media="(max-width: 767px)">
<script>document.documentElement.className = document.documentElement.className.replace('no-js','js');
/* failsafe: main.js sets window.dwMainOk as its last line. Deferred scripts run
   before DOMContentLoaded, so if it is still unset here the script failed to
   load or threw, and the page falls back to its no-script state (everything
   visible, nothing waiting on an entrance). */
/* an IntersectionObserver that never reports (blocked or broken) hands its
   targets to its callback as in view after 2.5s of visible time, so nothing
   that waits on an entrance stays hidden */
(function (W, D) {
  var IO = W.IntersectionObserver;
  if (!IO) return;
  function Watched(cb, opts) {
    var heard = false, list = [], t = 0;
    var io = new IO(function (es, o) { heard = true; cb(es, o); }, opts);
    var ob = io.observe, un = io.unobserve, dc = io.disconnect;
    function check() {
      if (heard || !list.length) return;
      if (D.hidden) { D.addEventListener('visibilitychange', function f() { D.removeEventListener('visibilitychange', f); t = setTimeout(check, 2500); }); return; }
      cb(list.slice().map(function (el) { var r = el.getBoundingClientRect();
        return { target: el, isIntersecting: true, intersectionRatio: 1, boundingClientRect: r, intersectionRect: r, rootBounds: null, time: 0 }; }), io);
    }
    io.observe = function (el) { list.push(el); ob.call(io, el); if (!t) t = setTimeout(check, 2500); };
    io.unobserve = function (el) { var i = list.indexOf(el); if (i > -1) list.splice(i, 1); un.call(io, el); };
    io.disconnect = function () { list = []; dc.call(io); };
    return io;
  }
  Watched.prototype = IO.prototype;
  W.IntersectionObserver = Watched;
})(window, document);
document.addEventListener('DOMContentLoaded', function () { setTimeout(function () { if (!window.dwMainOk) { var h = document.documentElement; h.className = h.className.replace(/(^|\s)js(\s|$)/, '$1no-js$2'); } }, 0); });</script>
{%- set ps = site.person %}
{%- if page.jsonld %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Person","@id":{{ ps.id | dump | safe }},"name":{{ ps.name | dump | safe }},
"alternateName":{{ ps.alternateName | dump | safe }},
"jobTitle":{{ ps.jobTitle | dump | safe }},
"description":{{ ps.description | dump | safe }},
"image":{{ ps.image | dump | safe }},
"url":{{ ps.url | dump | safe }},"email":{{ site.contact.email | dump | safe }},"telephone":{{ ps.telephone | dump | safe }},
"affiliation":{"@type":"CollegeOrUniversity","name":{{ ps.affiliation | dump | safe }}},
"knowsAbout":{{ ps.knowsAbout | dump | safe }}
{%- if site.socials and site.socials.length %},
"sameAs":[{% for s in site.socials %}{{ s.href | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}]{% endif %}}
</script>
{%- endif %}
{%- if page.videoSchema %}
{%- set vs = page.videoSchema %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"VideoObject","name":{{ vs.name | dump | safe }},
"description":{{ vs.description | dump | safe }},
"thumbnailUrl":{{ vs.thumbnailUrl | dump | safe }},
{%- if vs.uploadDate %}"uploadDate":{{ vs.uploadDate | dump | safe }},{% endif %}
"contentUrl":{{ vs.contentUrl | dump | safe }},"duration":{{ vs.duration | dump | safe }},
"inLanguage":{{ site.lang | dump | safe }},"creator":{"@id":{{ ps.id | dump | safe }}}}
</script>
{%- endif %}
{%- if page.profilePage %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ProfilePage","name":{{ page.title | dump | safe }},
"url":{{ page.canonical | dump | safe }},"mainEntity":{"@id":{{ ps.id | dump | safe }}}}
</script>
{%- endif %}
{%- if slug != 'home' %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":{{ site.crumbs.home | dump | safe }},"item":{{ ps.url | dump | safe }}},
{"@type":"ListItem","position":2,"name":{{ slug | crumbName(site, page.title) | dump | safe }},"item":{{ page.canonical | dump | safe }}}]}
</script>
{%- endif %}
</head>
<body data-fill="{{ site.ui.fillHeadings or 'phone' }}"{% if site.ui.fillStart %} data-fill-start="{{ site.ui.fillStart }}"{% endif %}{% if site.ui.fillEnd %} data-fill-end="{{ site.ui.fillEnd }}"{% endif %}{% if site.ui.fillStagger %} style="--fill-stagger:{{ site.ui.fillStagger }}"{% endif %}>
<script type="application/json" id="ui">{{ site.ui | dump | safe }}</script>
<a class="skip" href="#main">{{ site.ui.skip }}</a>

{%- if page.loader %}
{# {{ page.comments.loader | safe }} (this page only; a CSS failsafe in main.css hides it after 3s if the script never does) #}
<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__name"><span>{{ site.brand }}</span></div>
  <div class="loader__bar" id="loaderBar"></div>
</div>
{%- endif %}
<div class="grain" aria-hidden="true"></div>

{# {{ page.comments.nav | safe }} #}
{# phones: the brand large under the nav, moving into the nav as the hero scrolls (js module 13) #}
<span class="hero__name" aria-hidden="true">{{ site.brand }}</span>
{%- set firstType = (page.blocks | first).type if page.blocks else "" %}
<header class="nav" id="nav" data-scheme="{{ 'dark' if firstType == 'hero' or firstType == 'reelHero' else 'light' }}">
  {%- set bl = site.brandLink | navlink(slug, r) %}
  <a class="brand" href="{{ bl.href }}">{{ site.brand }}</a>
  <div class="nav-right">
    <nav class="nav-links" aria-label="{{ site.ui.navLabel }}">
    {%- for l in site.nav %}{% set nl = l | navlink(slug, r) %}
      <a href="{{ nl.href }}"{% if nl.current %} aria-current="page"{% endif %}>{{ l.label | inline() }}</a>
    {%- endfor %}
    </nav>
    <a class="nav-cta" href="{{ site.cta.href | root(r) }}"><span>{{ site.cta.label | inline() }}</span></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="drawer">{{ site.ui.menu }} <span class="bars"><i></i><i></i></span></button>
  </div>
</header>

<div class="drawer" id="drawer" aria-hidden="true" data-scheme="dark">
  <button class="drawer__close" aria-label="{{ site.ui.drawerCloseLabel }}">{{ site.ui.drawerClose }}</button>
  <nav aria-label="{{ site.ui.drawerLabel }}">
    {% for l in site.nav %}{% set nl = l | navlink(slug, r) %}<a href="{{ nl.href }}"{% if nl.current %} aria-current="page"{% endif %}>{{ l.label | inline() }}</a>{% endfor %}<a href="{{ site.cta.href | root(r) }}">{{ site.cta.label | inline() }}</a>
  </nav>
  <div class="drawer__foot"><a href="tel:{{ site.contact.tel }}">{{ site.contact.phone }}</a><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></div>
</div>

<main id="main"{% if theme.gradientSplit[slug] %} data-split="{{ theme.gradientSplit[slug] }}"{% endif %}{% if page.mainTabindex %} tabindex="{{ page.mainTabindex }}"{% endif %}>
{%- if page.ground %}
  {# The ground. One room under the whole page (a theatre from the back
       row) and a colour veil over it whose tone the scroll spine warms and
       cools as the page goes down. Every section that has no picture of its
       own is transparent, so the page has no bands; sections that ARE a
       picture (hero, the talks, the room, the walk-out) cover it. #}
  <div class="spk-ground" aria-hidden="true">
    <img class="spk-ground__img" src="{{ page.ground.image | root(r) }}"
         {%- set ss2 = page.ground.image | srcset(r) %}{% if ss2 %} srcset="{{ ss2 }}"{% endif %}
         sizes="{{ page.ground.sizes or '100vw' }}" alt="" decoding="async" fetchpriority="low">
    {%- if page.ground.veil %}
    <div class="spk-ground__veil"></div>
    {%- endif %}
  </div>
{%- endif %}
{% for b in page.blocks %}{% if b.enabled !== false and b.type != "close" %}{% set block = b %}
{% include "blocks/" + b.type + ".njk" %}
{% endif %}{% endfor %}
{%- if page.comments.mainEnd %}
  {# {{ page.comments.mainEnd | safe }} #}
{%- endif %}
</main>

<footer class="foot{% if page.footer and page.footer.class %} {{ page.footer.class }}{% endif %}" data-scheme="dark"{% if page.footer and page.footer.id %} id="{{ page.footer.id }}"{% endif %}>
{%- for b in page.blocks %}{% if b.enabled !== false and b.type == "close" %}{% set block = b %}
{% include "blocks/close.njk" %}
{%- endif %}{% endfor %}
  <div class="foot__grid">
    <div>
      <span class="brand">{{ site.brand }}</span>
      <p style="{{ site.footer.blurbStyle }}">{{ site.footer.blurb | inline() }}</p>
    </div>
    <div><h3>{{ site.footer.explore.heading }}</h3><ul>
      {%- for l in site.footer.explore.links %}{% set nl = l | navlink(slug, r) %}
      <li><a href="{{ nl.href }}"{% if nl.current %} aria-current="page"{% endif %}>{{ l.label | inline() }}</a></li>
      {%- endfor %}</ul></div>
    <div><h3>{{ site.footer.connect.heading }}</h3><ul>
      <li><a href="tel:{{ site.contact.tel }}">{{ site.contact.phone }}</a></li><li><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
      {%- for s in site.socials %}
      <li><a href="{{ s.href }}" target="_blank" rel="noopener">{{ s.label }}</a></li>
      {%- endfor %}</ul></div>
  </div>
  <div class="foot__base"><span>© <span data-year>{{ site.year }}</span> {{ site.brand }}</span><span>{{ site.tagline | inline() }}</span></div>
</footer>

{%- macro tabIcon(k) %}<svg class="tabbar__ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- if k == 'keynotes' %}<path d="M12 3.2c-1.9 0-3.1 1.3-3.1 3.1v5c0 1.8 1.3 3.2 3.1 3.2s3.1-1.4 3.1-3.2v-5c0-1.8-1.2-3.1-3.1-3.1z"/><path d="M5.9 10.8c.2 3.6 2.7 6.3 6.1 6.3 3.3 0 5.9-2.6 6.1-6.2"/><path d="M12 17.2v3.4M9 20.8c2-.2 4-.2 6.1 0"/>
{%- elif k == 'speaking' %}<path d="M4.2 6.6c.1-1.4 1.1-2.3 2.6-2.4 3.5-.2 6.9-.2 10.4 0 1.5.1 2.5 1 2.6 2.4.2 2.2.2 4.3 0 6.4-.1 1.4-1.1 2.3-2.6 2.4-2.4.1-4.6.1-6.9.1l-3.7 4.1.4-4.1c-1.6-.1-2.6-1-2.8-2.5-.2-2.1-.2-4.2 0-6.4z"/><path d="M8.4 9.6c2.4-.1 4.9-.1 7.3 0M8.4 12.2c1.5-.1 3-.1 4.6 0"/>
{%- elif k == 'healthcare' %}<path d="M12 19.6c-3.8-2.6-7.6-5.7-7.9-9.6-.2-2.6 1.6-4.7 4-4.8 1.6-.1 3 .8 3.9 2.3.9-1.5 2.3-2.4 3.9-2.3 2.4.1 4.2 2.2 4 4.8-.3 3.9-4.1 7-7.9 9.6z"/>
{%- else %}<path d="M4.4 7.2c.1-1.3.9-2.1 2.2-2.2 3.6-.2 7.2-.2 10.8 0 1.3.1 2.1.9 2.2 2.2.2 3.9.2 7.7 0 11.5-.1 1.3-.9 2.1-2.2 2.2-3.6.2-7.2.2-10.8 0-1.3-.1-2.1-.9-2.2-2.2-.2-3.8-.2-7.6 0-11.5z"/><path d="M8.2 3.4v3.3M15.8 3.4v3.3M4.6 9.9c4.9-.2 9.9-.2 14.8 0"/><path d="M9.1 14.6l2 2 3.9-4.3"/>
{%- endif %}</svg>{% endmacro %}
<nav class="tabbar" aria-label="{{ site.ui.navLabel }}" data-scheme="dark">
{%- for s in ['keynotes', 'speaking', 'healthcare'] %}{% for l in site.nav %}{% if l.slug == s %}{% set nl = l | navlink(slug, r) %}
  <a class="tabbar__tab" href="{{ nl.href }}"{% if nl.current %} aria-current="page"{% endif %}>{{ tabIcon(s) }}<span class="tabbar__label">{{ l.label | inline() }}</span></a>
{%- endif %}{% endfor %}{% endfor %}
  <a class="tabbar__tab tabbar__tab--book" href="{{ site.cta.href | root(r) }}"{% if slug == 'book' %} aria-current="page"{% endif %}>{{ tabIcon('book') }}<span class="tabbar__label">{{ site.cta.label | inline() }}</span></a>
</nav>

{% if page.lightbox -%}
<div class="lb" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ site.lightbox.label }}">
  <button class="lb__close" aria-label="{{ site.lightbox.closeLabel }}">{{ site.lightbox.close }}</button>
  <div class="lb__frame">
    <div class="lb__placeholder">
      <p class="eyebrow">{{ site.lightbox.eyebrow }}</p>
      <p>{{ site.lightbox.text | inline() }}</p>
      <p style="{{ site.lightbox.ctaStyle }}"><a class="btn btn--inv" href="{{ site.lightbox.cta.href | root(r) }}">{{ site.lightbox.cta.label | inline() }}</a></p>
    </div>
  </div>
</div>

{% endif -%}
{% for s in page.scripts %}<script src="{{ s | root(r) }}?v={{ s | stamp }}" defer></script>
{% endfor %}<script src="{{ site.head.script | root(r) }}?v={{ site.head.script | stamp }}" defer></script>
<script src="{{ 'js/phone.js' | root(r) }}?v={{ 'js/phone.js' | stamp }}" defer></script>
</body>
</html>
